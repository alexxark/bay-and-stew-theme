{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ===== LOAD MORE BUTTON ===== */
  .load-more-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin: 3rem 0;
  }

  #load-more-btn {
    cursor: pointer;
    transition: all 0.3s ease;
  }

  #load-more-btn:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 2px;
  }

  #load-more-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Loading spinner */
  .load-more-spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 3px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    border-top-color: currentColor;
    animation: load-more-spin 0.8s linear infinite;
  }

  @keyframes load-more-spin {
    to { transform: rotate(360deg); }
  }

  /* Fade-in for newly loaded products - GPU accelerated */
  @keyframes loadMoreFadeIn {
    from { opacity: 0; transform: translate3d(0, 8px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  /* Screen reader only */
  .load-more-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  {%- paginate collection.products by 12 -%}
    {% comment %} Sort is the first tabbable element when filter type is vertical {% endcomment %}
    {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
      <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
        <form class="facets-vertical-form" id="FacetSortForm">
          <div class="facet-filters sorting caption">
            <div class="facet-filters__field">
              <h2 class="facet-filters__label caption-large text-body">
                <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
              </h2>
              <div class="select">
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                <select
                  name="sort_by"
                  class="facet-filters__sort select__select caption-large"
                  id="SortBy"
                  aria-describedby="a11y-refresh-page-message"
                >
                  {%- for option in collection.sort_options -%}
                    <option
                      value="{{ option.value | escape }}"
                      {% if option.value == sort_by %}
                        selected="selected"
                      {% endif %}
                    >
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
          </div>

          <div class="product-count-vertical light" role="status">
            <h2 class="product-count__text text-body">
              <span id="ProductCountDesktop">
                {%- if collection.results_count -%}
                  {{
                    'templates.search.results_with_count'
                    | t: terms: collection.terms, count: collection.results_count
                  }}
                {%- elsif collection.products_count == collection.all_products_count -%}
                  {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                {%- else -%}
                  {{
                    'products.facets.product_count'
                    | t: product_count: collection.products_count, count: collection.all_products_count
                  }}
                {%- endif -%}
              </span>
            </h2>
            {%- render 'loading-spinner' -%}
          </div>
        </form>
      </facet-filters-form>
    {%- endif -%}

    <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}">
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          aria-label="{{ 'products.facets.filter_and_sort' | t | default: 'Filter and sort' }}"
          class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: section.settings.filter_type,
            paginate: paginate
          %}
        </aside>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div
            class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          >
            {%- capture collection_context_url -%}
              {{ request.path }}{%- if request.query_string != blank -%}?{{ request.query_string }}{%- endif -%}
            {%- endcapture -%}
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              data-collection-url="{{ collection_context_url | strip }}"
              data-collection-title="{{ collection.title | escape }}"
              class="
                grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                grid--{{ section.settings.columns_desktop }}-col-desktop
                {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
              "
            >
              {%- comment -%}
                Wholesale gating for non-B2B customers is handled inline by
                the `price` snippet (price replaced with an "Apply for
                wholesale" CTA). Products are shown to everyone here.
              {%- endcomment -%}

              {% assign skip_card_product_styles = false %}
              {%- for product in collection.products -%}
                {%- comment -%}start BSS Commerce Hide Price{%- endcomment -%}
                {%- capture bss_lock_check -%}{%- render 'bss-lock-condition', scope: 'subject', subject: product, variable: 'transparent' -%}{%- endcapture -%}
                {%- if bss_lock_check contains 'true' -%}{%- continue -%}{%- endif -%}
                {%- comment -%}end BSS Commerce Hide Price{%- endcomment -%}

                {% assign lazy_load = false %}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}
                <li
                  class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    lazy_load: lazy_load,
                    skip_styles: skip_card_product_styles,
                    quick_add: section.settings.quick_add,
                    section_id: section.id
                  %}
                </li>
                {%- assign skip_card_product_styles = true -%}

                {%- comment -%}
                  Collection Showcases: render image/gif tiles after a configured
                  product position. Tiles take the same grid slot/aspect ratio as
                  product cards so the grid layout stays intact.

                  Use the absolute position across all paginated pages
                  (`paginate.current_offset + forloop.index`) so each showcase
                  only appears once as pages are appended via Load More.
                {%- endcomment -%}
                {%- assign current_position = paginate.current_offset | plus: forloop.index -%}
                {%- for showcase_i in (1..5) -%}
                  {%- assign showcase_pos_key = 'showcase_' | append: showcase_i | append: '_position' -%}
                  {%- assign showcase_img_key = 'showcase_' | append: showcase_i | append: '_image' -%}
                  {%- assign showcase_pos = section.settings[showcase_pos_key] -%}
                  {%- assign showcase_img = section.settings[showcase_img_key] -%}
                  {%- if showcase_img != blank and showcase_pos > 0 and showcase_pos == current_position -%}
                    <li
                      class="grid__item collection-showcase-item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      <div class="collection-showcase">
                        <img
                          src="{{ showcase_img | image_url: width: 1100 }}"
                          srcset="
                            {{ showcase_img | image_url: width: 360 }} 360w,
                            {{ showcase_img | image_url: width: 540 }} 540w,
                            {{ showcase_img | image_url: width: 720 }} 720w,
                            {{ showcase_img | image_url: width: 900 }} 900w,
                            {{ showcase_img | image_url: width: 1100 }} 1100w
                          "
                          sizes="(min-width: 1200px) calc((100vw - 10rem) / {{ section.settings.columns_desktop }}), (min-width: 750px) calc((100vw - 10rem) / {{ section.settings.columns_desktop }}), calc((100vw - 3rem) / {{ section.settings.columns_mobile }})"
                          alt="{{ showcase_img.alt | default: collection.title | escape }}"
                          width="{{ showcase_img.width }}"
                          height="{{ showcase_img.height }}"
                          loading="lazy"
                        >
                      </div>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </ul>

            {%- comment -%} Load More button replaces standard pagination {%- endcomment -%}
            {%- if paginate.next -%}
              <div class="load-more-container" id="load-more-wrapper">
                <button
                  id="load-more-btn"
                  class="button"
                  type="button"
                  data-next-url="{{ paginate.next.url }}"
                  aria-label="Load more products in the {{ collection.title }} collection"
                  aria-busy="false"
                >
                  Load More Products
                </button>
                <div id="loading-spinner" class="load-more-spinner" style="display: none;" aria-hidden="true"></div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

{%- comment -%}
  ================================================================
  LOAD MORE JAVASCRIPT
  Prefetches next page in background so prices are ready instantly.
  Uses event delegation so it works after filter changes.
  ================================================================
{%- endcomment -%}
<script>
  (function() {
    var COLLECTION_STATE_DEBUG = window.COLLECTION_STATE_DEBUG === true;
    var STORAGE_PREFIX = 'bs:collection-state:v1:';
    var PRODUCT_CONTEXT_KEY = 'bs:product-collection-context:v1';
    var ACTIVE_PRODUCT_CONTEXT_KEY = 'bs:active-product-context:v1';
    var RETURN_INTENT_KEY = 'bs:collection-return-intent:v1';
    var STATE_MAX_AGE_MS = 6 * 60 * 60 * 1000;
    var PRODUCT_CONTEXT_MAX_AGE_MS = 24 * 60 * 60 * 1000;
    var ACTIVE_PRODUCT_CONTEXT_MAX_AGE_MS = 60 * 60 * 1000;
    var RETURN_INTENT_MAX_AGE_MS = 45 * 60 * 1000;

    function debugLog(message, payload) {
      if (!COLLECTION_STATE_DEBUG) return;
      if (typeof payload === 'undefined') {
        console.info('[Collection State] ' + message);
      } else {
        console.info('[Collection State] ' + message, payload);
      }
    }

    if (window.__bsCollectionStateInit) {
      debugLog('Already initialized - skipping duplicate script execution');
      return;
    }
    window.__bsCollectionStateInit = true;
    debugLog('Initializing');

    var loadMoreListenerAttached = false;
    var loadMoreInProgress = false;
    var restoreInProgress = false;
    var restoreAttemptedForKey = null;
    var restoredFromBFCache = false;
    var runtimeLoadedPages = 0;
    var loadedBatchUrls = [];
    var scrollThrottleTimer = null;
    var lastSavedScrollY = 0;

    // Prefetch cache - stores pre-loaded and pre-processed items
    var prefetchCache = {
      url: null,
      items: null,
      nextUrl: null,
      isLoading: false,
      isReady: false
    };

    // Hidden container for prefetched items (allows BSS to process them)
    var prefetchContainer = null;

    function safeParseJSON(raw, fallback) {
      if (!raw) return fallback;
      try {
        return JSON.parse(raw);
      } catch (error) {
        return fallback;
      }
    }

    function readSessionItem(key) {
      try {
        return window.sessionStorage.getItem(key);
      } catch (error) {
        return null;
      }
    }

    function writeSessionItem(key, value) {
      try {
        window.sessionStorage.setItem(key, value);
      } catch (error) {
        // Ignore storage failures and continue normal browsing.
      }
    }

    function removeSessionItem(key) {
      try {
        window.sessionStorage.removeItem(key);
      } catch (error) {
        // Ignore storage failures and continue normal browsing.
      }
    }

    function getNavigationType() {
      try {
        var navEntries = performance.getEntriesByType('navigation');
        if (navEntries && navEntries.length > 0 && navEntries[0].type) {
          return navEntries[0].type;
        }
      } catch (error) {
        // No-op.
      }
      return '';
    }

    function normalizeProductPath(urlString) {
      if (!urlString) return '';
      try {
        var parsed = new URL(urlString, window.location.origin);
        return parsed.pathname.replace(/\/+$/, '') || parsed.pathname;
      } catch (error) {
        return '';
      }
    }

    function normalizeCollectionUrl(urlString) {
      try {
        var parsed = new URL(urlString, window.location.origin);
        var params = new URLSearchParams(parsed.search);
        params.sort();
        var sortedSearch = params.toString();
        return parsed.pathname + (sortedSearch ? '?' + sortedSearch : '');
      } catch (error) {
        return window.location.pathname + window.location.search;
      }
    }

    function getCollectionStateKey() {
      if (!/^\/collections\//.test(window.location.pathname)) return null;
      return STORAGE_PREFIX + normalizeCollectionUrl(window.location.pathname + window.location.search);
    }

    function getCollectionMeta() {
      var grid = document.getElementById('product-grid');
      var currentCollectionUrl = normalizeCollectionUrl(window.location.pathname + window.location.search);
      if (!grid) {
        return {
          collectionUrl: currentCollectionUrl,
          collectionTitle: document.title || ''
        };
      }

      return {
        collectionUrl: currentCollectionUrl,
        collectionTitle: grid.dataset.collectionTitle || document.title || ''
      };
    }

    function sanitizeCollectionState(state) {
      if (!state || typeof state !== 'object') return null;
      var timestamp = Number(state.timestamp || 0);
      if (!timestamp || Date.now() - timestamp > STATE_MAX_AGE_MS) return null;

      return {
        version: Number(state.version || 1),
        collectionUrl: typeof state.collectionUrl === 'string' ? state.collectionUrl : '',
        loadedPages: Math.max(parseInt(state.loadedPages, 10) || 0, 0),
        loadedBatchUrls: Array.isArray(state.loadedBatchUrls) ? state.loadedBatchUrls.slice(0, 100) : [],
        nextPageUrl: typeof state.nextPageUrl === 'string' ? state.nextPageUrl : null,
        scrollY: Math.max(Number(state.scrollY || 0), 0),
        timestamp: timestamp,
        clickedProductUrl: typeof state.clickedProductUrl === 'string' ? state.clickedProductUrl : '',
        clickedProductPath: typeof state.clickedProductPath === 'string' ? state.clickedProductPath : '',
        clickedProductHandle: typeof state.clickedProductHandle === 'string' ? state.clickedProductHandle : ''
      };
    }

    function readCollectionStateRaw() {
      var key = getCollectionStateKey();
      if (!key) return null;
      var parsed = safeParseJSON(readSessionItem(key), null);
      return sanitizeCollectionState(parsed);
    }

    function getCollectionState() {
      var key = getCollectionStateKey();
      if (!key) return null;
      var state = readCollectionStateRaw();
      if (!state) {
        debugLog('No saved state for this URL');
      }
      return state;
    }

    function writeCollectionState(state) {
      var key = getCollectionStateKey();
      if (!key) return;
      writeSessionItem(key, JSON.stringify(state));
    }

    function pruneCollectionStateStorage() {
      try {
        for (var i = window.sessionStorage.length - 1; i >= 0; i -= 1) {
          var key = window.sessionStorage.key(i);
          if (!key || key.indexOf(STORAGE_PREFIX) !== 0) continue;
          var parsed = safeParseJSON(readSessionItem(key), null);
          var sanitized = sanitizeCollectionState(parsed);
          if (!sanitized) {
            removeSessionItem(key);
          }
        }
      } catch (error) {
        // Ignore cleanup failures.
      }
    }

    function getLoadMoreButton() {
      return document.getElementById('load-more-btn');
    }

    function persistCollectionState(extra, reason) {
      var key = getCollectionStateKey();
      if (!key) return;

      var existing = readCollectionStateRaw() || {};
      var btn = getLoadMoreButton();
      var meta = getCollectionMeta();

      var state = {
        version: 1,
        collectionUrl: meta.collectionUrl,
        loadedPages: runtimeLoadedPages,
        loadedBatchUrls: loadedBatchUrls.slice(),
        nextPageUrl: btn && btn.dataset.nextUrl ? btn.dataset.nextUrl : null,
        scrollY: Math.max(window.scrollY || 0, 0),
        timestamp: Date.now(),
        clickedProductUrl: existing.clickedProductUrl || '',
        clickedProductPath: existing.clickedProductPath || '',
        clickedProductHandle: existing.clickedProductHandle || ''
      };

      if (extra && typeof extra === 'object') {
        Object.assign(state, extra);
      }

      writeCollectionState(state);

      if (reason && reason !== 'scroll') {
        debugLog('Saved state:', {
          reason: reason,
          key: key,
          loadedPages: state.loadedPages,
          nextPageUrl: state.nextPageUrl,
          clickedProductPath: state.clickedProductPath,
          scrollY: state.scrollY
        });
      }
    }

    function markBatchLoaded(sourceUrl, nextUrl, addedCount) {
      if (!addedCount || addedCount < 1) return;

      runtimeLoadedPages += 1;
      if (sourceUrl) {
        var normalizedUrl = normalizeCollectionUrl(sourceUrl);
        if (loadedBatchUrls.indexOf(normalizedUrl) === -1) {
          loadedBatchUrls.push(normalizedUrl);
        }
      }

      debugLog('Loaded pages: ' + runtimeLoadedPages);
      persistCollectionState(
        {
          nextPageUrl: nextUrl || null
        },
        'load-more'
      );
    }

    function getReturnIntent() {
      var parsed = safeParseJSON(readSessionItem(RETURN_INTENT_KEY), null);
      if (!parsed || typeof parsed !== 'object') return null;

      var timestamp = Number(parsed.timestamp || 0);
      if (!timestamp || Date.now() - timestamp > RETURN_INTENT_MAX_AGE_MS) {
        removeSessionItem(RETURN_INTENT_KEY);
        return null;
      }

      if (!parsed.collectionKey || typeof parsed.collectionKey !== 'string') return null;
      return parsed;
    }

    function setReturnIntent(intent) {
      if (!intent || !intent.collectionKey) return;
      writeSessionItem(RETURN_INTENT_KEY, JSON.stringify(intent));
    }

    function consumeReturnIntent() {
      removeSessionItem(RETURN_INTENT_KEY);
    }

    function shouldRestoreForVisit(collectionStateKey) {
      var intent = getReturnIntent();
      var navType = getNavigationType();

      if (!intent) {
        return {
          shouldRestore: false,
          consumeIntent: false,
          reason: 'no-return-intent'
        };
      }

      if (intent.collectionKey !== collectionStateKey) {
        return {
          shouldRestore: false,
          consumeIntent: false,
          reason: 'intent-for-different-collection'
        };
      }

      if (intent.mode === 'breadcrumb') {
        return {
          shouldRestore: true,
          consumeIntent: true,
          reason: 'breadcrumb-return'
        };
      }

      if (intent.mode === 'product-click' && navType === 'back_forward') {
        return {
          shouldRestore: true,
          consumeIntent: true,
          reason: 'browser-back-return'
        };
      }

      return {
        shouldRestore: false,
        consumeIntent: true,
        reason: 'intent-present-but-not-return-navigation'
      };
    }

    function createPrefetchContainer() {
      if (prefetchContainer) return prefetchContainer;
      prefetchContainer = document.createElement('div');
      prefetchContainer.id = 'load-more-prefetch';
      prefetchContainer.setAttribute('aria-hidden', 'true');
      prefetchContainer.style.cssText =
        'position:absolute;left:-9999px;top:-9999px;visibility:hidden;pointer-events:none;';
      document.body.appendChild(prefetchContainer);
      return prefetchContainer;
    }

    function resetPrefetchCache() {
      prefetchCache.url = null;
      prefetchCache.items = null;
      prefetchCache.nextUrl = null;
      prefetchCache.isLoading = false;
      prefetchCache.isReady = false;
    }

    // Prefetch the next page in the background
    function prefetchNextPage(url) {
      if (!url || prefetchCache.isLoading || prefetchCache.url === url) return;

      prefetchCache.isLoading = true;
      prefetchCache.url = url;
      prefetchCache.isReady = false;

      fetch(url)
        .then(function(response) {
          return response.text();
        })
        .then(function(html) {
          var parser = new DOMParser();
          var doc = parser.parseFromString(html, 'text/html');
          var newItems = doc.querySelectorAll('#product-grid > li');
          var nextBtn = doc.querySelector('#load-more-btn');

          prefetchCache.nextUrl = nextBtn ? nextBtn.dataset.nextUrl : null;

          var container = createPrefetchContainer();
          container.innerHTML = '';

          var hiddenGrid = document.createElement('ul');
          hiddenGrid.id = 'prefetch-product-grid';
          hiddenGrid.className = 'product-grid';

          Array.from(newItems).forEach(function(item) {
            hiddenGrid.appendChild(item);
          });

          container.appendChild(hiddenGrid);
          triggerBSSPriceRefresh(container);

          setTimeout(function() {
            prefetchCache.items = Array.from(hiddenGrid.querySelectorAll('li'));
            prefetchCache.isReady = true;
            prefetchCache.isLoading = false;
          }, 800);
        })
        .catch(function(error) {
          console.error('Prefetch error:', error);
          prefetchCache.isLoading = false;
          prefetchCache.url = null;
        });
    }

    function displayPrefetchedItems(productGrid, items, done) {
      if (!items || items.length === 0) {
        if (typeof done === 'function') done(0);
        return;
      }

      var fragment = document.createDocumentFragment();

      items.forEach(function(item, index) {
        item.classList.add('load-more-fade-in');
        item.style.cssText = 'opacity:1;transform:translateY(0);animation-delay:' + index * 0.02 + 's';
        item.classList.remove('scroll-trigger');
        fragment.appendChild(item);
      });

      requestAnimationFrame(function() {
        productGrid.appendChild(fragment);
        announceLoadMoreToScreenReader(items.length + ' new products loaded');
        if (typeof done === 'function') done(items.length);
      });
    }

    function dispatchLoadMoreComplete(detail) {
      document.dispatchEvent(
        new CustomEvent('baystew:load-more-complete', {
          bubbles: true,
          detail: detail || {}
        })
      );
    }

    function handleLoadMoreClick(event) {
      var btn = event.target.closest('#load-more-btn');
      if (!btn) return;

      event.preventDefault();
      if (loadMoreInProgress) return;

      var loadingSpinner = document.getElementById('loading-spinner');
      var loadMoreWrapper = document.getElementById('load-more-wrapper');
      var productGrid = document.getElementById('product-grid');

      if (!productGrid) {
        dispatchLoadMoreComplete({ success: false, reason: 'missing-grid' });
        return;
      }

      var nextUrl = btn.dataset.nextUrl;
      if (!nextUrl) {
        dispatchLoadMoreComplete({ success: false, reason: 'missing-next-url' });
        return;
      }

      loadMoreInProgress = true;

      function finalize(detail) {
        loadMoreInProgress = false;
        dispatchLoadMoreComplete(detail);
      }

      if (prefetchCache.isReady && prefetchCache.url === nextUrl && prefetchCache.items) {
        displayPrefetchedItems(productGrid, prefetchCache.items, function(addedCount) {
          var updatedNextUrl = prefetchCache.nextUrl || null;

          if (updatedNextUrl) {
            btn.dataset.nextUrl = updatedNextUrl;
            prefetchCache.url = null;
            prefetchCache.items = null;
            prefetchCache.isReady = false;
            prefetchNextPage(updatedNextUrl);
          } else if (loadMoreWrapper) {
            loadMoreWrapper.style.display = 'none';
          }

          btn.disabled = false;
          btn.setAttribute('aria-busy', 'false');
          if (loadingSpinner) loadingSpinner.style.display = 'none';

          markBatchLoaded(nextUrl, updatedNextUrl, addedCount);

          finalize({
            success: addedCount > 0,
            addedCount: addedCount,
            sourceUrl: nextUrl,
            nextUrl: updatedNextUrl,
            restored: restoreInProgress
          });
        });
        return;
      }

      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      if (loadingSpinner) loadingSpinner.style.display = 'inline-block';

      fetch(nextUrl)
        .then(function(response) {
          return response.text();
        })
        .then(function(html) {
          var parser = new DOMParser();
          var doc = parser.parseFromString(html, 'text/html');
          var newItems = Array.from(doc.querySelectorAll('#product-grid > li'));
          var fragment = document.createDocumentFragment();

          newItems.forEach(function(item, index) {
            item.classList.add('load-more-fade-in');
            item.style.cssText = 'opacity:1;transform:translateY(0);animation-delay:' + index * 0.03 + 's';
            item.classList.remove('scroll-trigger');
            fragment.appendChild(item);
          });

          var newLoadMoreBtn = doc.querySelector('#load-more-btn');
          var updatedNextUrl = newLoadMoreBtn && newLoadMoreBtn.dataset.nextUrl ? newLoadMoreBtn.dataset.nextUrl : null;

          requestAnimationFrame(function() {
            if (newItems.length > 0) {
              productGrid.appendChild(fragment);
              triggerBSSPriceRefresh(productGrid);
              announceLoadMoreToScreenReader(newItems.length + ' new products loaded');
            }

            if (updatedNextUrl) {
              btn.dataset.nextUrl = updatedNextUrl;
              btn.disabled = false;
              btn.setAttribute('aria-busy', 'false');
              if (loadingSpinner) loadingSpinner.style.display = 'none';
              prefetchNextPage(updatedNextUrl);
            } else {
              if (loadMoreWrapper) loadMoreWrapper.style.display = 'none';
              if (loadingSpinner) loadingSpinner.style.display = 'none';
            }

            markBatchLoaded(nextUrl, updatedNextUrl, newItems.length);

            finalize({
              success: newItems.length > 0,
              addedCount: newItems.length,
              sourceUrl: nextUrl,
              nextUrl: updatedNextUrl,
              restored: restoreInProgress
            });
          });
        })
        .catch(function(error) {
          console.error('Load more error:', error);
          btn.disabled = false;
          btn.setAttribute('aria-busy', 'false');
          if (loadingSpinner) loadingSpinner.style.display = 'none';
          finalize({
            success: false,
            addedCount: 0,
            sourceUrl: nextUrl,
            nextUrl: btn.dataset.nextUrl || null,
            restored: restoreInProgress,
            error: true
          });
        });
    }

    // Trigger BSS B2B and other third-party apps to process new price elements
    function triggerBSSPriceRefresh(container) {
      var sectionId = null;
      if (container && typeof container.closest === 'function') {
        var parentWithSection = container.closest('[data-section-id]');
        sectionId = parentWithSection ? parentWithSection.dataset.sectionId : null;
      }

      document.dispatchEvent(
        new CustomEvent('shopify:section:load', {
          bubbles: true,
          detail: { sectionId: sectionId }
        })
      );

      container.dispatchEvent(new CustomEvent('bss:content:updated', { bubbles: true }));

      if (typeof window.BSSB2B !== 'undefined' && typeof window.BSSB2B.refresh === 'function') {
        window.BSSB2B.refresh();
      }
      if (typeof window.BSSCommerce !== 'undefined' && typeof window.BSSCommerce.initPrices === 'function') {
        window.BSSCommerce.initPrices(container);
      }

      var priceElements = container.querySelectorAll('[bss-b2b-product-price]');
      priceElements.forEach(function(element) {
        element.setAttribute('data-bss-refresh', Date.now());
      });

      document.dispatchEvent(new CustomEvent('price:refresh', { detail: { container: container } }));

      if (typeof window.BssB2BTax !== 'undefined' && typeof window.BssB2BTax.calculate === 'function') {
        window.BssB2BTax.calculate();
      }
    }

    function announceLoadMoreToScreenReader(message) {
      var announcer = document.getElementById('load-more-announcer');
      if (!announcer) {
        announcer = document.createElement('div');
        announcer.id = 'load-more-announcer';
        announcer.className = 'load-more-sr-only';
        announcer.setAttribute('role', 'status');
        announcer.setAttribute('aria-live', 'polite');
        document.body.appendChild(announcer);
      }
      announcer.textContent = '';
      setTimeout(function() {
        announcer.textContent = message;
      }, 100);
    }

    function readProductContextMap() {
      return safeParseJSON(readSessionItem(PRODUCT_CONTEXT_KEY), {});
    }

    function writeProductContextMap(map) {
      writeSessionItem(PRODUCT_CONTEXT_KEY, JSON.stringify(map));
    }

    function saveProductCollectionContext(productPath) {
      if (!productPath) return;

      var contextMap = readProductContextMap();
      var now = Date.now();
      var contextMeta = getCollectionMeta();

      contextMap[productPath] = {
        collectionUrl: contextMeta.collectionUrl,
        collectionTitle: contextMeta.collectionTitle,
        timestamp: now
      };

      Object.keys(contextMap).forEach(function(key) {
        var item = contextMap[key];
        if (!item || !item.timestamp || now - item.timestamp > PRODUCT_CONTEXT_MAX_AGE_MS) {
          delete contextMap[key];
        }
      });

      var contextKeys = Object.keys(contextMap);
      if (contextKeys.length > 200) {
        contextKeys
          .sort(function(a, b) {
            var aTs = contextMap[a] && contextMap[a].timestamp ? contextMap[a].timestamp : 0;
            var bTs = contextMap[b] && contextMap[b].timestamp ? contextMap[b].timestamp : 0;
            return bTs - aTs;
          })
          .slice(200)
          .forEach(function(staleKey) {
            delete contextMap[staleKey];
          });
      }

      writeProductContextMap(contextMap);
    }

    function saveActiveProductContext(productPath) {
      var key = getCollectionStateKey();
      if (!key || !productPath) return;
      var contextMeta = getCollectionMeta();
      writeSessionItem(
        ACTIVE_PRODUCT_CONTEXT_KEY,
        JSON.stringify({
          productPath: productPath,
          collectionUrl: contextMeta.collectionUrl,
          collectionTitle: contextMeta.collectionTitle,
          timestamp: Date.now()
        })
      );

      setReturnIntent({
        collectionKey: key,
        collectionUrl: contextMeta.collectionUrl,
        collectionTitle: contextMeta.collectionTitle,
        productPath: productPath,
        mode: 'product-click',
        timestamp: Date.now()
      });
    }

    function extractProductHandle(productPath) {
      var parts = productPath.split('/').filter(Boolean);
      return parts.length ? parts[parts.length - 1] : '';
    }

    function handleProductLinkClick(event) {
      var productLink = event.target.closest('#product-grid a[href*="/products/"]');
      if (!productLink) return;
      if (productLink.closest('.quick-add, quick-add-bulk, quick-add-modal, product-form')) return;

      var productPath = normalizeProductPath(productLink.getAttribute('href'));
      if (!productPath) return;

      saveProductCollectionContext(productPath);
      saveActiveProductContext(productPath);

      persistCollectionState(
        {
          scrollY: Math.max(window.scrollY || 0, 0),
          clickedProductUrl: productPath,
          clickedProductPath: productPath,
          clickedProductHandle: extractProductHandle(productPath)
        },
        'product-click'
      );

      debugLog('Product clicked: ' + productPath);
    }

    function saveScrollStateIfNeeded(force) {
      var currentScrollY = Math.max(window.scrollY || 0, 0);
      if (!force && Math.abs(currentScrollY - lastSavedScrollY) < 120) return;
      lastSavedScrollY = currentScrollY;
      persistCollectionState({ scrollY: currentScrollY }, force ? 'pagehide' : 'scroll');
    }

    function handleScrollPersist() {
      if (scrollThrottleTimer) return;
      scrollThrottleTimer = setTimeout(function() {
        scrollThrottleTimer = null;
        saveScrollStateIfNeeded(false);
      }, 250);
    }

    function getHeaderOffset() {
      var header =
        document.querySelector('#shopify-section-header-group .section-header') ||
        document.querySelector('.section-header') ||
        document.querySelector('header');
      if (!header) return 80;
      return Math.round(header.getBoundingClientRect().height + 24);
    }

    function findProductElementInGrid(productPath) {
      if (!productPath) return null;
      var links = document.querySelectorAll('#product-grid a[href*="/products/"]');
      for (var i = 0; i < links.length; i += 1) {
        var candidatePath = normalizeProductPath(links[i].getAttribute('href'));
        if (candidatePath === productPath) {
          return links[i].closest('li') || links[i].closest('.grid__item') || links[i];
        }
      }
      return null;
    }

    function waitForNextFrame() {
      return new Promise(function(resolve) {
        requestAnimationFrame(function() {
          requestAnimationFrame(resolve);
        });
      });
    }

    function waitForGridImages(container, timeoutMs) {
      if (!container) return Promise.resolve();
      var images = Array.from(container.querySelectorAll('img')).filter(function(image) {
        return !image.complete;
      });
      if (!images.length) return Promise.resolve();

      var settledPromise = Promise.all(
        images.map(function(image) {
          return new Promise(function(resolve) {
            image.addEventListener('load', resolve, { once: true });
            image.addEventListener('error', resolve, { once: true });
          });
        })
      );

      return Promise.race([
        settledPromise,
        new Promise(function(resolve) {
          setTimeout(resolve, timeoutMs || 1200);
        })
      ]);
    }

    function restoreScrollPosition(savedState) {
      if (!savedState) return;
      if (restoredFromBFCache) return;
      if ((window.scrollY || 0) > 100) return;

      var productPath = savedState.clickedProductPath || savedState.clickedProductUrl || '';
      var productElement = findProductElementInGrid(productPath);
      if (productElement) {
        debugLog('Scrolling to clicked product');
        var offset = getHeaderOffset();
        var targetTop = productElement.getBoundingClientRect().top + window.pageYOffset - offset;
        window.scrollTo(0, Math.max(targetTop, 0));

        setTimeout(function() {
          var adjustedTop = productElement.getBoundingClientRect().top + window.pageYOffset - offset;
          var difference = Math.abs((window.scrollY || 0) - Math.max(adjustedTop, 0));
          if (difference > 40) {
            window.scrollTo(0, Math.max(adjustedTop, 0));
          }
        }, 220);
        return;
      }

      if (typeof savedState.scrollY === 'number' && savedState.scrollY > 0) {
        debugLog('Falling back to scrollY');
        window.scrollTo(0, savedState.scrollY);
      }
    }

    function triggerLoadMoreAndWait() {
      return new Promise(function(resolve) {
        var btn = getLoadMoreButton();
        if (!btn || !btn.dataset.nextUrl || btn.disabled) {
          resolve({ success: false, reason: 'no-next-page' });
          return;
        }

        var completed = false;
        var timeoutId = null;

        function cleanup() {
          if (timeoutId) clearTimeout(timeoutId);
          document.removeEventListener('baystew:load-more-complete', onLoadMoreComplete);
        }

        function onLoadMoreComplete(completeEvent) {
          if (completed) return;
          completed = true;
          cleanup();
          resolve(completeEvent.detail || { success: false, reason: 'unknown' });
        }

        document.addEventListener('baystew:load-more-complete', onLoadMoreComplete);
        timeoutId = setTimeout(function() {
          if (completed) return;
          completed = true;
          cleanup();
          resolve({ success: false, reason: 'timeout' });
        }, 10000);

        btn.click();
      });
    }

    function hasDomAlreadyRestored(savedState) {
      if (!savedState || savedState.loadedPages < 1) return false;
      var btn = getLoadMoreButton();
      var currentNextUrl = btn && btn.dataset.nextUrl ? normalizeCollectionUrl(btn.dataset.nextUrl) : null;
      var savedNextUrl = savedState.nextPageUrl ? normalizeCollectionUrl(savedState.nextPageUrl) : null;

      if (currentNextUrl === savedNextUrl) {
        return true;
      }

      if (!btn && !savedNextUrl) {
        return true;
      }

      return false;
    }

    async function restoreCollectionStateIfNeeded() {
      var key = getCollectionStateKey();
      if (!key) return;
      if (restoreInProgress || restoredFromBFCache) return;
      if (restoreAttemptedForKey === key) return;

      restoreAttemptedForKey = key;
      debugLog('State key: ' + key);

      var restoreDecision = shouldRestoreForVisit(key);
      if (!restoreDecision.shouldRestore) {
        if (restoreDecision.reason === 'intent-present-but-not-return-navigation') {
          debugLog('Skipping restore for normal fresh visit');
        }
        if (restoreDecision.consumeIntent) {
          consumeReturnIntent();
        }
        return;
      }

      var savedState = getCollectionState();
      if (!savedState) {
        if (restoreDecision.consumeIntent) {
          consumeReturnIntent();
        }
        return;
      }

      debugLog('Restoring state:', savedState);

      if (hasDomAlreadyRestored(savedState)) {
        debugLog('bfcache restored page - skipping AJAX restore');
        restoreScrollPosition(savedState);
        if (restoreDecision.consumeIntent) {
          consumeReturnIntent();
        }
        return;
      }

      var targetLoads = Math.max(parseInt(savedState.loadedPages, 10) || 0, 0);

      restoreInProgress = true;
      try {
        for (var i = 0; i < targetLoads; i += 1) {
          debugLog('Restoring page ' + (i + 2));
          var result = await triggerLoadMoreAndWait();
          if (!result || !result.success) {
            debugLog('Restore failed gracefully: ' + ((result && result.reason) || 'unknown'));
            break;
          }
        }

        var productGrid = document.getElementById('product-grid');
        await waitForNextFrame();
        await waitForGridImages(productGrid, 1600);
        await waitForNextFrame();

        restoreScrollPosition(savedState);
        debugLog('Restore complete');
      } finally {
        restoreInProgress = false;
      }

      if (restoreDecision.consumeIntent) {
        consumeReturnIntent();
      }
      persistCollectionState({}, 'restore');
    }

    function schedulePrefetch(delayMs) {
      setTimeout(function() {
        var btn = getLoadMoreButton();
        if (btn && btn.dataset.nextUrl) {
          prefetchNextPage(btn.dataset.nextUrl);
        }
      }, delayMs);
    }

    function resetRuntimeStateForCurrentGrid() {
      runtimeLoadedPages = 0;
      loadedBatchUrls = [];
      lastSavedScrollY = Math.max(window.scrollY || 0, 0);
    }

    if (!loadMoreListenerAttached) {
      document.addEventListener('click', handleLoadMoreClick);
      loadMoreListenerAttached = true;
    }

    document.addEventListener('click', handleProductLinkClick, true);
    window.addEventListener('scroll', handleScrollPersist, { passive: true });
    window.addEventListener('pagehide', function() {
      saveScrollStateIfNeeded(true);
    });

    window.addEventListener('pageshow', function(pageShowEvent) {
      if (pageShowEvent.persisted) {
        restoredFromBFCache = true;
        debugLog('bfcache restored page - skipping AJAX restore');
        var key = getCollectionStateKey();
        var intent = getReturnIntent();
        if (intent && key && intent.collectionKey === key) {
          consumeReturnIntent();
        }
        return;
      }
      restoreCollectionStateIfNeeded();
    });

    function onCollectionPageReady() {
      pruneCollectionStateStorage();
      resetRuntimeStateForCurrentGrid();
      restoreCollectionStateIfNeeded();
      schedulePrefetch(1500);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', onCollectionPageReady);
    } else {
      onCollectionPageReady();
    }

    // Reset state cache and prefetch after AJAX filter/sort replacements.
    document.addEventListener('facets:updated', function() {
      debugLog('Facet/sort URL changed');
      resetPrefetchCache();
      resetRuntimeStateForCurrentGrid();
      restoreAttemptedForKey = null;
      restoreCollectionStateIfNeeded();
      schedulePrefetch(1000);
    });
  })();
</script>

