{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ===== LOAD MORE BUTTON ===== */
  .load-more-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin: 3rem 0;
  }

  #load-more-btn {
    cursor: pointer;
    transition: all 0.3s ease;
  }

  #load-more-btn:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 2px;
  }

  #load-more-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Loading spinner */
  .load-more-spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 3px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    border-top-color: currentColor;
    animation: load-more-spin 0.8s linear infinite;
  }

  @keyframes load-more-spin {
    to { transform: rotate(360deg); }
  }

  /* Fade-in for newly loaded products - GPU accelerated */
  @keyframes loadMoreFadeIn {
    from { opacity: 0; transform: translate3d(0, 8px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  /* Screen reader only */
  .load-more-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  {%- paginate collection.products by 12 -%}
    {% comment %} Sort is the first tabbable element when filter type is vertical {% endcomment %}
    {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
      <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
        <form class="facets-vertical-form" id="FacetSortForm">
          <div class="facet-filters sorting caption">
            <div class="facet-filters__field">
              <h2 class="facet-filters__label caption-large text-body">
                <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
              </h2>
              <div class="select">
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                <select
                  name="sort_by"
                  class="facet-filters__sort select__select caption-large"
                  id="SortBy"
                  aria-describedby="a11y-refresh-page-message"
                >
                  {%- for option in collection.sort_options -%}
                    <option
                      value="{{ option.value | escape }}"
                      {% if option.value == sort_by %}
                        selected="selected"
                      {% endif %}
                    >
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
          </div>

          <div class="product-count-vertical light" role="status">
            <h2 class="product-count__text text-body">
              <span id="ProductCountDesktop">
                {%- if collection.results_count -%}
                  {{
                    'templates.search.results_with_count'
                    | t: terms: collection.terms, count: collection.results_count
                  }}
                {%- elsif collection.products_count == collection.all_products_count -%}
                  {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                {%- else -%}
                  {{
                    'products.facets.product_count'
                    | t: product_count: collection.products_count, count: collection.all_products_count
                  }}
                {%- endif -%}
              </span>
            </h2>
            {%- render 'loading-spinner' -%}
          </div>
        </form>
      </facet-filters-form>
    {%- endif -%}

    <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}">
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          aria-label="{{ 'products.facets.filter_and_sort' | t | default: 'Filter and sort' }}"
          class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: section.settings.filter_type,
            paginate: paginate
          %}
        </aside>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div
            class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          >
            {%- capture collection_context_url -%}
              {{ request.path }}{%- if request.query_string != blank -%}?{{ request.query_string }}{%- endif -%}
            {%- endcapture -%}
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              data-collection-url="{{ collection_context_url | strip }}"
              data-collection-title="{{ collection.title | escape }}"
              class="
                grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                grid--{{ section.settings.columns_desktop }}-col-desktop
                {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
              "
            >
              {%- comment -%}
                Wholesale gating for non-B2B customers is handled inline by
                the `price` snippet (price replaced with an "Apply for
                wholesale" CTA). Products are shown to everyone here.
              {%- endcomment -%}

              {% assign skip_card_product_styles = false %}
              {%- for product in collection.products -%}
                {%- comment -%}start BSS Commerce Hide Price{%- endcomment -%}
                {%- capture bss_lock_check -%}{%- render 'bss-lock-condition', scope: 'subject', subject: product, variable: 'transparent' -%}{%- endcapture -%}
                {%- if bss_lock_check contains 'true' -%}{%- continue -%}{%- endif -%}
                {%- comment -%}end BSS Commerce Hide Price{%- endcomment -%}

                {% assign lazy_load = false %}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}
                <li
                  class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    lazy_load: lazy_load,
                    skip_styles: skip_card_product_styles,
                    quick_add: section.settings.quick_add,
                    section_id: section.id
                  %}
                </li>
                {%- assign skip_card_product_styles = true -%}

                {%- comment -%}
                  Collection Showcases: render image/gif tiles after a configured
                  product position. Tiles take the same grid slot/aspect ratio as
                  product cards so the grid layout stays intact.

                  Use the absolute position across all paginated pages
                  (`paginate.current_offset + forloop.index`) so each showcase
                  only appears once as pages are appended via Load More.
                {%- endcomment -%}
                {%- assign current_position = paginate.current_offset | plus: forloop.index -%}
                {%- for showcase_i in (1..5) -%}
                  {%- assign showcase_pos_key = 'showcase_' | append: showcase_i | append: '_position' -%}
                  {%- assign showcase_img_key = 'showcase_' | append: showcase_i | append: '_image' -%}
                  {%- assign showcase_pos = section.settings[showcase_pos_key] -%}
                  {%- assign showcase_img = section.settings[showcase_img_key] -%}
                  {%- if showcase_img != blank and showcase_pos > 0 and showcase_pos == current_position -%}
                    <li
                      class="grid__item collection-showcase-item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      <div class="collection-showcase">
                        <img
                          src="{{ showcase_img | image_url: width: 1100 }}"
                          srcset="
                            {{ showcase_img | image_url: width: 360 }} 360w,
                            {{ showcase_img | image_url: width: 540 }} 540w,
                            {{ showcase_img | image_url: width: 720 }} 720w,
                            {{ showcase_img | image_url: width: 900 }} 900w,
                            {{ showcase_img | image_url: width: 1100 }} 1100w
                          "
                          sizes="(min-width: 1200px) calc((100vw - 10rem) / {{ section.settings.columns_desktop }}), (min-width: 750px) calc((100vw - 10rem) / {{ section.settings.columns_desktop }}), calc((100vw - 3rem) / {{ section.settings.columns_mobile }})"
                          alt="{{ showcase_img.alt | default: collection.title | escape }}"
                          width="{{ showcase_img.width }}"
                          height="{{ showcase_img.height }}"
                          loading="lazy"
                        >
                      </div>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </ul>

            {%- comment -%} Load More button replaces standard pagination {%- endcomment -%}
            {%- if paginate.next -%}
              <div class="load-more-container" id="load-more-wrapper">
                <button
                  id="load-more-btn"
                  class="button"
                  type="button"
                  data-next-url="{{ paginate.next.url }}"
                  aria-label="Load more products in the {{ collection.title }} collection"
                  aria-busy="false"
                >
                  Load More Products
                </button>
                <div id="loading-spinner" class="load-more-spinner" style="display: none;" aria-hidden="true"></div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

{%- comment -%}
  ================================================================
  LOAD MORE JAVASCRIPT
  Prefetches next page in background so prices are ready instantly.
  Uses event delegation so it works after filter changes.
  ================================================================
{%- endcomment -%}
<script>
  (function() {
    var COLLECTION_STATE_DEBUG = window.COLLECTION_STATE_DEBUG === true;
    var STORAGE_PREFIX = 'bs:collection-state:v1:';
    var PRODUCT_CONTEXT_KEY = 'bs:product-collection-context:v1';
    var ACTIVE_PRODUCT_CONTEXT_KEY = 'bs:active-product-context:v1';
    var RETURN_INTENT_KEY = 'bs:collection-return-intent:v1';
    var STATE_MAX_AGE_MS = 6 * 60 * 60 * 1000;
    var PRODUCT_CONTEXT_MAX_AGE_MS = 24 * 60 * 60 * 1000;
    var ACTIVE_PRODUCT_CONTEXT_MAX_AGE_MS = 60 * 60 * 1000;
    var RETURN_INTENT_MAX_AGE_MS = 45 * 60 * 1000;
    var MAX_BATCHES_PER_STATE = 12;
    var MAX_STATE_BATCH_HTML_CHARS = 1000000;
    var MAX_STORED_COLLECTION_STATES = 6;

    function debugLog(message, payload) {
      if (!COLLECTION_STATE_DEBUG) return;
      if (typeof payload === 'undefined') {
        console.info('[Collection State] ' + message);
      } else {
        console.info('[Collection State] ' + message, payload);
      }
    }

    function perfLog(message, valueMs) {
      if (!COLLECTION_STATE_DEBUG) return;
      console.info('[Collection State Perf] ' + message + ': ' + Math.round(valueMs) + ' ms');
    }

    function perfEventLog(message, payload) {
      if (!COLLECTION_STATE_DEBUG) return;
      if (typeof payload === 'undefined') {
        console.info('[Collection State Perf] ' + message);
      } else {
        console.info('[Collection State Perf] ' + message, payload);
      }
    }

    if (window.__bsCollectionStateInit) {
      debugLog('Already initialized - skipping duplicate script execution');
      return;
    }
    window.__bsCollectionStateInit = true;
    debugLog('Initializing');

    var loadMoreListenerAttached = false;
    var loadMoreInProgress = false;
    var restoreInProgress = false;
    var restoreOperationInProgress = false;
    var activeRestoreOperationId = null;
    var restoreAttemptedForKey = null;
    var restoredFromBFCache = false;
    var runtimeLoadedPages = 0;
    var loadedBatchUrls = [];
    var scrollThrottleTimer = null;
    var lastSavedScrollY = 0;
    var browserBackDetected = false;
    var scriptInitPerfAt = performance.now();
    var domReadyPerfAt = null;
    var lastPageShowPerfAt = null;
    var restoreIdCounter = 1;

    // Prefetch cache - stores pre-loaded and pre-processed items
    var prefetchCache = {
      url: null,
      items: null,
      itemsHtml: '',
      nextUrl: null,
      isLoading: false,
      isReady: false
    };

    // Hidden container for prefetched items (allows BSS to process them)
    var prefetchContainer = null;

    function createRestoreOperation(triggerSource) {
      var now = performance.now();
      var navType = getNavigationType();
      var usePageShowBaseline = navType === 'back_forward' && typeof lastPageShowPerfAt === 'number';
      var restoreOperation = {
        id: String(Date.now()) + '-' + String(restoreIdCounter),
        trigger: triggerSource || 'unknown',
        startedAt: now,
        baselineAt: usePageShowBaseline ? lastPageShowPerfAt : scriptInitPerfAt,
        baselineType: usePageShowBaseline ? 'pageshow' : 'init',
        totalLogged: false
      };

      restoreIdCounter += 1;
      return restoreOperation;
    }

    function logRestoreStage(restoreOperation, stageName, payload) {
      if (!COLLECTION_STATE_DEBUG || !restoreOperation) return;
      var now = performance.now();
      var stagePayload = Object.assign(
        {
          restoreId: restoreOperation.id,
          trigger: restoreOperation.trigger,
          baseline: restoreOperation.baselineType,
          sinceBaselineMs: Math.round(now - restoreOperation.baselineAt),
          sinceRestoreStartMs: Math.round(now - restoreOperation.startedAt)
        },
        payload || {}
      );

      console.info(
        '[Collection State Perf] ' + stageName + ': ' + stagePayload.sinceBaselineMs + ' ms',
        stagePayload
      );
    }

    function logTotalReturnToProduct(restoreOperation, payload) {
      if (!COLLECTION_STATE_DEBUG || !restoreOperation || restoreOperation.totalLogged) return;
      restoreOperation.totalLogged = true;

      var totalMs = Math.round(performance.now() - restoreOperation.baselineAt);
      var totalPayload = Object.assign(
        {
          restoreId: restoreOperation.id,
          trigger: restoreOperation.trigger,
          baseline: restoreOperation.baselineType,
          totalMs: totalMs
        },
        payload || {}
      );

      console.info('[Collection State Perf] TOTAL return-to-product: ' + totalMs + ' ms', totalPayload);
    }

    function safeParseJSON(raw, fallback) {
      if (!raw) return fallback;
      try {
        return JSON.parse(raw);
      } catch (error) {
        return fallback;
      }
    }

    function readSessionItem(key) {
      try {
        return window.sessionStorage.getItem(key);
      } catch (error) {
        return null;
      }
    }

    function isQuotaExceededError(error) {
      if (!error) return false;
      return (
        error.name === 'QuotaExceededError' ||
        error.name === 'NS_ERROR_DOM_QUOTA_REACHED' ||
        error.code === 22 ||
        error.code === 1014
      );
    }

    function collectCollectionStateEntriesForCleanup(activeStateKey) {
      var entries = [];
      var now = Date.now();

      for (var i = window.sessionStorage.length - 1; i >= 0; i -= 1) {
        var stateKey = window.sessionStorage.key(i);
        if (!stateKey || stateKey.indexOf(STORAGE_PREFIX) !== 0) continue;

        var parsed = safeParseJSON(readSessionItem(stateKey), null);
        if (!parsed || typeof parsed !== 'object') {
          removeSessionItem(stateKey);
          continue;
        }

        var timestamp = Number(parsed.timestamp || 0);
        var batchCache = Array.isArray(parsed.batchCache) ? parsed.batchCache : [];

        entries.push({
          key: stateKey,
          state: parsed,
          timestamp: timestamp || 0,
          expired: !timestamp || now - timestamp > STATE_MAX_AGE_MS,
          isActive: stateKey === activeStateKey,
          cachedBatches: batchCache.length,
          cachedChars: getBatchCacheSizeChars(batchCache)
        });
      }

      return entries;
    }

    function logEvictedInactiveCollectionCache(entry, reason) {
      debugLog('Evicted inactive collection cache: ' + entry.key, {
        reason: reason,
        cachedBatches: entry.cachedBatches || 0,
        cachedChars: entry.cachedChars || 0,
        timestamp: entry.timestamp || 0
      });
    }

    function logActiveCacheStats(activeStateKey) {
      if (!activeStateKey) return;

      var activeState = sanitizeCollectionState(safeParseJSON(readSessionItem(activeStateKey), null));
      var activeBatchCache = activeState && Array.isArray(activeState.batchCache) ? activeState.batchCache : [];

      debugLog('Active cache chars: ' + getBatchCacheSizeChars(activeBatchCache));
      debugLog('Active cached batches: ' + activeBatchCache.length);
    }

    function cleanupCollectionStateStorageForQuota(activeStateKey) {
      var changed = false;
      var entries = collectCollectionStateEntriesForCleanup(activeStateKey);

      entries
        .filter(function(entry) {
          return entry.expired;
        })
        .forEach(function(entry) {
          removeSessionItem(entry.key);
          changed = true;
        });

      var freshEntries = entries.filter(function(entry) {
        return !entry.expired;
      });

      var inactiveEntries = freshEntries
        .filter(function(entry) {
          return !entry.isActive;
        })
        .sort(function(a, b) {
          return a.timestamp - b.timestamp;
        });

      var maxInactiveStates = Math.max(MAX_STORED_COLLECTION_STATES - (activeStateKey ? 1 : 0), 0);
      var statesToEvict = Math.max(inactiveEntries.length - maxInactiveStates, 0);

      inactiveEntries.slice(0, statesToEvict).forEach(function(entry) {
        removeSessionItem(entry.key);
        logEvictedInactiveCollectionCache(entry, 'oldest-inactive-state');
        changed = true;
      });

      inactiveEntries.slice(statesToEvict).forEach(function(entry) {
        var batchCache = Array.isArray(entry.state.batchCache) ? entry.state.batchCache : [];
        if (!batchCache.length) return;

        entry.state.batchCache = [];
        var updatedSerialized = JSON.stringify(entry.state);

        try {
          window.sessionStorage.setItem(entry.key, updatedSerialized);
          logEvictedInactiveCollectionCache(entry, 'inactive-batch-cache');
          changed = true;
        } catch (error) {
          removeSessionItem(entry.key);
          logEvictedInactiveCollectionCache(entry, 'inactive-state-after-trim-failed');
          changed = true;
        }
      });

      logActiveCacheStats(activeStateKey);
      return changed;
    }

    function writeSessionItem(key, value) {
      try {
        window.sessionStorage.setItem(key, value);
      } catch (error) {
        if (isQuotaExceededError(error)) {
          debugLog('Storage quota pressure');

          var activeStateKey = key && key.indexOf(STORAGE_PREFIX) === 0 ? key : getCollectionStateKey();
          cleanupCollectionStateStorageForQuota(activeStateKey);

          try {
            window.sessionStorage.setItem(key, value);
            return;
          } catch (retryError) {
            debugLog('sessionStorage write failed', {
              key: key,
              error: retryError && retryError.message ? retryError.message : retryError
            });
            return;
          }
        }

        debugLog('sessionStorage write failed', {
          key: key,
          error: error && error.message ? error.message : error
        });
      }
    }

    function removeSessionItem(key) {
      try {
        window.sessionStorage.removeItem(key);
      } catch (error) {
        // Ignore storage failures and continue normal browsing.
      }
    }

    function getNavigationType() {
      try {
        var navEntries = performance.getEntriesByType('navigation');
        if (navEntries && navEntries.length > 0 && navEntries[0].type) {
          return navEntries[0].type;
        }
      } catch (error) {
        // No-op.
      }
      return '';
    }

    function getNavigationEntry() {
      try {
        var entries = performance.getEntriesByType('navigation');
        return entries && entries.length ? entries[0] : null;
      } catch (error) {
        return null;
      }
    }

    function getNotRestoredReasons() {
      var entry = getNavigationEntry();
      if (!entry || typeof entry.notRestoredReasons === 'undefined') return null;
      return entry.notRestoredReasons;
    }

    function formatBFCacheReason(reasonEntry) {
      if (!reasonEntry) return 'unknown';
      if (typeof reasonEntry === 'string') return reasonEntry;
      if (typeof reasonEntry.reason === 'string' && reasonEntry.reason) return reasonEntry.reason;
      if (typeof reasonEntry.type === 'string' && reasonEntry.type) return reasonEntry.type;
      if (typeof reasonEntry.name === 'string' && reasonEntry.name) return reasonEntry.name;
      return 'unknown';
    }

    function collectBFCacheBlockers(node, inheritedContext, output) {
      if (!node) return;

      if (Array.isArray(node)) {
        node.forEach(function(item) {
          collectBFCacheBlockers(item, inheritedContext, output);
        });
        return;
      }

      if (typeof node !== 'object') return;

      var context = Object.assign({}, inheritedContext || {});
      if (typeof node.url === 'string' && node.url) context.url = node.url;
      if (typeof node.src === 'string' && node.src) context.source = node.src;
      if (typeof node.id === 'string' && node.id) context.frame = node.id;
      if (typeof node.name === 'string' && node.name) context.frame = node.name;

      if (Array.isArray(node.reasons) && node.reasons.length) {
        node.reasons.forEach(function(reasonEntry) {
          var blockerContext = Object.assign({}, context);
          if (reasonEntry && typeof reasonEntry === 'object') {
            if (typeof reasonEntry.context === 'string' && reasonEntry.context) {
              blockerContext.context = reasonEntry.context;
            } else if (typeof reasonEntry.details === 'string' && reasonEntry.details) {
              blockerContext.context = reasonEntry.details;
            }
            if (typeof reasonEntry.url === 'string' && reasonEntry.url) blockerContext.url = reasonEntry.url;
            if (typeof reasonEntry.src === 'string' && reasonEntry.src) blockerContext.source = reasonEntry.src;
          }

          output.push({
            reason: formatBFCacheReason(reasonEntry),
            context: blockerContext.context || '',
            source: blockerContext.source || '',
            url: blockerContext.url || '',
            frame: blockerContext.frame || ''
          });
        });
      }

      if (Array.isArray(node.children) && node.children.length) {
        node.children.forEach(function(child) {
          collectBFCacheBlockers(child, context, output);
        });
      }
    }

    function extractBFCacheBlockers(reasons) {
      if (!reasons) return [];
      var blockers = [];
      collectBFCacheBlockers(reasons, {}, blockers);
      return blockers;
    }

    function logBackForwardDiagnostics(pageShowEvent) {
      debugLog('pageshow persisted: ' + Boolean(pageShowEvent && pageShowEvent.persisted));
      debugLog('navigation type: ' + (getNavigationType() || 'unknown'));
      var reasons = getNotRestoredReasons();
      debugLog('bfcache not restored reasons:', reasons === null ? 'not supported or none' : reasons);
      var blockers = extractBFCacheBlockers(reasons);
      blockers.forEach(function(blocker, index) {
        debugLog('bfcache blocker ' + (index + 1) + ': ' + blocker.reason, {
          context: blocker.context || '',
          source: blocker.source || '',
          url: blocker.url || '',
          frame: blocker.frame || ''
        });
      });
      try {
        if (window.history && typeof window.history.scrollRestoration !== 'undefined') {
          debugLog('history.scrollRestoration: ' + window.history.scrollRestoration);
        }
      } catch (error) {
        // No-op.
      }
    }

    function normalizeProductPath(urlString) {
      if (!urlString) return '';
      try {
        var parsed = new URL(urlString, window.location.origin);
        return parsed.pathname.replace(/\/+$/, '') || parsed.pathname;
      } catch (error) {
        return '';
      }
    }

    function normalizeCollectionUrl(urlString) {
      try {
        var parsed = new URL(urlString, window.location.origin);
        var params = new URLSearchParams(parsed.search);
        params.sort();
        var sortedSearch = params.toString();
        return parsed.pathname + (sortedSearch ? '?' + sortedSearch : '');
      } catch (error) {
        return window.location.pathname + window.location.search;
      }
    }

    function getCollectionStateKey() {
      if (!/^\/collections\//.test(window.location.pathname)) return null;
      return STORAGE_PREFIX + normalizeCollectionUrl(window.location.pathname + window.location.search);
    }

    function getCollectionMeta() {
      var grid = document.getElementById('product-grid');
      var currentCollectionUrl = normalizeCollectionUrl(window.location.pathname + window.location.search);
      if (!grid) {
        return {
          collectionUrl: currentCollectionUrl,
          collectionTitle: document.title || ''
        };
      }

      return {
        collectionUrl: currentCollectionUrl,
        collectionTitle: grid.dataset.collectionTitle || document.title || ''
      };
    }

    function sanitizeCollectionState(state) {
      if (!state || typeof state !== 'object') return null;
      var timestamp = Number(state.timestamp || 0);
      if (!timestamp || Date.now() - timestamp > STATE_MAX_AGE_MS) return null;

      return {
        version: Number(state.version || 1),
        collectionUrl: typeof state.collectionUrl === 'string' ? state.collectionUrl : '',
        loadedPages: Math.max(parseInt(state.loadedPages, 10) || 0, 0),
        loadedBatchUrls: Array.isArray(state.loadedBatchUrls) ? state.loadedBatchUrls.slice(0, 100) : [],
        batchCache: Array.isArray(state.batchCache)
          ? state.batchCache
              .map(function(batch) {
                if (!batch || typeof batch !== 'object') return null;
                if (typeof batch.pageUrl !== 'string' || typeof batch.itemsHtml !== 'string') return null;
                return {
                  pageUrl: batch.pageUrl,
                  itemsHtml: batch.itemsHtml,
                  nextPageUrl: typeof batch.nextPageUrl === 'string' ? batch.nextPageUrl : null,
                  timestamp: Number(batch.timestamp || timestamp)
                };
              })
              .filter(Boolean)
              .slice(0, MAX_BATCHES_PER_STATE)
          : [],
        nextPageUrl: typeof state.nextPageUrl === 'string' ? state.nextPageUrl : null,
        scrollY: Math.max(Number(state.scrollY || 0), 0),
        timestamp: timestamp,
        clickedProductUrl: typeof state.clickedProductUrl === 'string' ? state.clickedProductUrl : '',
        clickedProductPath: typeof state.clickedProductPath === 'string' ? state.clickedProductPath : '',
        clickedProductHandle: typeof state.clickedProductHandle === 'string' ? state.clickedProductHandle : ''
      };
    }

    function readCollectionStateRaw() {
      var key = getCollectionStateKey();
      if (!key) return null;
      var parsed = safeParseJSON(readSessionItem(key), null);
      return sanitizeCollectionState(parsed);
    }

    function getCollectionState() {
      var key = getCollectionStateKey();
      if (!key) return null;
      var state = readCollectionStateRaw();
      if (!state) {
        debugLog('No saved state for this URL');
      }
      return state;
    }

    function writeCollectionState(state) {
      var key = getCollectionStateKey();
      if (!key) return;
      writeSessionItem(key, JSON.stringify(state));
    }

    function pruneCollectionStateStorage() {
      try {
        var activeStateKey = getCollectionStateKey();
        var entries = collectCollectionStateEntriesForCleanup(activeStateKey);

        entries
          .filter(function(entry) {
            return entry.expired;
          })
          .forEach(function(entry) {
            removeSessionItem(entry.key);
          });

        var freshInactiveEntries = entries
          .filter(function(entry) {
            return !entry.expired && !entry.isActive;
          })
          .sort(function(a, b) {
            return a.timestamp - b.timestamp;
          });

        var maxInactiveStates = Math.max(MAX_STORED_COLLECTION_STATES - (activeStateKey ? 1 : 0), 0);
        var inactiveStatesToRemove = Math.max(freshInactiveEntries.length - maxInactiveStates, 0);

        freshInactiveEntries.slice(0, inactiveStatesToRemove).forEach(function(entry) {
          removeSessionItem(entry.key);
        });
      } catch (error) {
        // Ignore cleanup failures.
      }
    }

    function getLoadMoreButton() {
      return document.getElementById('load-more-btn');
    }

    function updateCollectionHistoryState(state, key) {
      if (!state || !key || typeof history.replaceState !== 'function') return;
      var existingState = history.state && typeof history.state === 'object' ? history.state : {};
      var nextState = Object.assign({}, existingState, {
        collectionStateMeta: {
          collectionStateKey: key,
          clickedProduct: state.clickedProductPath || state.clickedProductUrl || '',
          loadedPages: state.loadedPages || 0,
          scrollY: Math.round(state.scrollY || 0),
          timestamp: Date.now()
        }
      });

      try {
        history.replaceState(nextState, '', window.location.href);
      } catch (error) {
        // Ignore history state failures.
      }
    }

    function persistCollectionState(extra, reason) {
      var key = getCollectionStateKey();
      if (!key) return;

      var existing = readCollectionStateRaw() || {};
      var btn = getLoadMoreButton();
      var meta = getCollectionMeta();

      var state = {
        version: 1,
        collectionUrl: meta.collectionUrl,
        loadedPages: runtimeLoadedPages,
        loadedBatchUrls: loadedBatchUrls.slice(),
        batchCache: Array.isArray(existing.batchCache) ? existing.batchCache : [],
        nextPageUrl: btn && btn.dataset.nextUrl ? btn.dataset.nextUrl : null,
        scrollY: Math.max(window.scrollY || 0, 0),
        timestamp: Date.now(),
        clickedProductUrl: existing.clickedProductUrl || '',
        clickedProductPath: existing.clickedProductPath || '',
        clickedProductHandle: existing.clickedProductHandle || ''
      };

      if (extra && typeof extra === 'object') {
        Object.assign(state, extra);
      }

      writeCollectionState(state);

      if (reason && reason !== 'scroll') {
        updateCollectionHistoryState(state, key);
      }

      if (reason && reason !== 'scroll') {
        debugLog('Saved state:', {
          reason: reason,
          key: key,
          loadedPages: state.loadedPages,
          nextPageUrl: state.nextPageUrl,
          clickedProductPath: state.clickedProductPath,
          scrollY: state.scrollY
        });
      }
    }

    function getBatchCacheSizeChars(batchCache) {
      if (!Array.isArray(batchCache)) return 0;
      return batchCache.reduce(function(total, batch) {
        if (!batch || typeof batch.itemsHtml !== 'string') return total;
        return total + batch.itemsHtml.length;
      }, 0);
    }

    function cacheBatchForCurrentState(pageUrl, itemsHtml, nextPageUrl) {
      if (!pageUrl || !itemsHtml) return;

      var state = readCollectionStateRaw() || {
        version: 1,
        collectionUrl: getCollectionMeta().collectionUrl,
        loadedPages: runtimeLoadedPages,
        loadedBatchUrls: loadedBatchUrls.slice(),
        batchCache: [],
        nextPageUrl: nextPageUrl || null,
        scrollY: Math.max(window.scrollY || 0, 0),
        timestamp: Date.now(),
        clickedProductUrl: '',
        clickedProductPath: '',
        clickedProductHandle: ''
      };

      var normalizedPageUrl = normalizeCollectionUrl(pageUrl);
      var updatedBatches = (state.batchCache || []).filter(function(batch) {
        return batch.pageUrl !== normalizedPageUrl;
      });

      updatedBatches.push({
        pageUrl: normalizedPageUrl,
        itemsHtml: itemsHtml,
        nextPageUrl: nextPageUrl || null,
        timestamp: Date.now()
      });

      var removedForCountLimit = 0;
      while (updatedBatches.length > MAX_BATCHES_PER_STATE) {
        updatedBatches.shift();
        removedForCountLimit += 1;
      }

      var removedForSizeLimit = 0;
      while (getBatchCacheSizeChars(updatedBatches) > MAX_STATE_BATCH_HTML_CHARS && updatedBatches.length > 1) {
        updatedBatches.shift();
        removedForSizeLimit += 1;
      }

      state.batchCache = updatedBatches;
      state.timestamp = Date.now();
      writeCollectionState(state);

      if (removedForCountLimit || removedForSizeLimit) {
        debugLog('Batch cache trimmed', {
          pageUrl: normalizedPageUrl,
          loadedPages: state.loadedPages,
          removedForCountLimit: removedForCountLimit,
          removedForSizeLimit: removedForSizeLimit,
          cachedBatches: updatedBatches.length,
          cachedChars: getBatchCacheSizeChars(updatedBatches),
          maxBatches: MAX_BATCHES_PER_STATE,
          maxChars: MAX_STATE_BATCH_HTML_CHARS
        });
      }

      debugLog('Saved state:', {
        reason: 'batch-cache',
        pageUrl: normalizedPageUrl,
        cachedBatches: updatedBatches.length,
        cachedChars: getBatchCacheSizeChars(updatedBatches)
      });
    }

    function markBatchLoaded(sourceUrl, nextUrl, addedCount, itemsHtml) {
      if (!addedCount || addedCount < 1) return;

      runtimeLoadedPages += 1;
      if (sourceUrl) {
        var normalizedUrl = normalizeCollectionUrl(sourceUrl);
        if (loadedBatchUrls.indexOf(normalizedUrl) === -1) {
          loadedBatchUrls.push(normalizedUrl);
        }
      }

      if (sourceUrl && itemsHtml) {
        cacheBatchForCurrentState(sourceUrl, itemsHtml, nextUrl || null);
      }

      debugLog('Loaded pages: ' + runtimeLoadedPages);
      persistCollectionState(
        {
          nextPageUrl: nextUrl || null
        },
        'load-more'
      );
    }

    function getReturnIntent() {
      var parsed = safeParseJSON(readSessionItem(RETURN_INTENT_KEY), null);
      if (!parsed || typeof parsed !== 'object') return null;

      var timestamp = Number(parsed.timestamp || 0);
      if (!timestamp || Date.now() - timestamp > RETURN_INTENT_MAX_AGE_MS) {
        removeSessionItem(RETURN_INTENT_KEY);
        return null;
      }

      if (!parsed.collectionKey || typeof parsed.collectionKey !== 'string') return null;
      return parsed;
    }

    function setReturnIntent(intent) {
      if (!intent || !intent.collectionKey) return;
      writeSessionItem(RETURN_INTENT_KEY, JSON.stringify(intent));
    }

    function consumeReturnIntent() {
      removeSessionItem(RETURN_INTENT_KEY);
    }

    function shouldRestoreForVisit(collectionStateKey) {
      var intent = getReturnIntent();
      var navType = getNavigationType();

      if (!intent) {
        return {
          shouldRestore: false,
          consumeIntent: false,
          reason: 'no-return-intent'
        };
      }

      if (intent.collectionKey !== collectionStateKey) {
        return {
          shouldRestore: false,
          consumeIntent: false,
          reason: 'intent-for-different-collection'
        };
      }

      if (intent.mode === 'breadcrumb') {
        return {
          shouldRestore: true,
          consumeIntent: true,
          reason: 'breadcrumb-return'
        };
      }

      if (intent.mode === 'product-click' && navType === 'back_forward') {
        return {
          shouldRestore: true,
          consumeIntent: true,
          reason: 'browser-back-return'
        };
      }

      return {
        shouldRestore: false,
        consumeIntent: true,
        reason: 'intent-present-but-not-return-navigation'
      };
    }

    function createPrefetchContainer() {
      if (prefetchContainer) return prefetchContainer;
      prefetchContainer = document.createElement('div');
      prefetchContainer.id = 'load-more-prefetch';
      prefetchContainer.setAttribute('aria-hidden', 'true');
      prefetchContainer.style.cssText =
        'position:absolute;left:-9999px;top:-9999px;visibility:hidden;pointer-events:none;';
      document.body.appendChild(prefetchContainer);
      return prefetchContainer;
    }

    function resetPrefetchCache() {
      prefetchCache.url = null;
      prefetchCache.items = null;
      prefetchCache.itemsHtml = '';
      prefetchCache.nextUrl = null;
      prefetchCache.isLoading = false;
      prefetchCache.isReady = false;
    }

    // Prefetch the next page in the background
    function prefetchNextPage(url) {
      if (!url || prefetchCache.isLoading || prefetchCache.url === url) return;

      prefetchCache.isLoading = true;
      prefetchCache.url = url;
      prefetchCache.isReady = false;

      fetch(url)
        .then(function(response) {
          return response.text();
        })
        .then(function(html) {
          var parser = new DOMParser();
          var doc = parser.parseFromString(html, 'text/html');
          var newItems = doc.querySelectorAll('#product-grid > li');
          var newItemsArray = Array.from(newItems);
          var batchItemsHtml = newItemsArray
            .map(function(item) {
              return item.outerHTML;
            })
            .join('');
          var nextBtn = doc.querySelector('#load-more-btn');

          prefetchCache.nextUrl = nextBtn ? nextBtn.dataset.nextUrl : null;
          prefetchCache.itemsHtml = batchItemsHtml;

          var container = createPrefetchContainer();
          container.innerHTML = '';

          var hiddenGrid = document.createElement('ul');
          hiddenGrid.id = 'prefetch-product-grid';
          hiddenGrid.className = 'product-grid';

          newItemsArray.forEach(function(item) {
            hiddenGrid.appendChild(item);
          });

          container.appendChild(hiddenGrid);
          triggerBSSPriceRefresh(container);

          setTimeout(function() {
            prefetchCache.items = Array.from(hiddenGrid.querySelectorAll('li'));
            prefetchCache.isReady = true;
            prefetchCache.isLoading = false;
          }, 800);
        })
        .catch(function(error) {
          console.error('Prefetch error:', error);
          prefetchCache.isLoading = false;
          prefetchCache.url = null;
        });
    }

    function displayPrefetchedItems(productGrid, items, done) {
      if (!items || items.length === 0) {
        if (typeof done === 'function') done(0);
        return;
      }

      var fragment = document.createDocumentFragment();

      items.forEach(function(item, index) {
        item.classList.add('load-more-fade-in');
        item.style.cssText = 'opacity:1;transform:translateY(0);animation-delay:' + index * 0.02 + 's';
        item.classList.remove('scroll-trigger');
        fragment.appendChild(item);
      });

      requestAnimationFrame(function() {
        productGrid.appendChild(fragment);
        announceLoadMoreToScreenReader(items.length + ' new products loaded');
        if (typeof done === 'function') done(items.length);
      });
    }

    function dispatchLoadMoreComplete(detail) {
      document.dispatchEvent(
        new CustomEvent('baystew:load-more-complete', {
          bubbles: true,
          detail: detail || {}
        })
      );
    }

    function handleLoadMoreClick(event) {
      var btn = event.target.closest('#load-more-btn');
      if (!btn) return;

      event.preventDefault();
      if (loadMoreInProgress) return;

      var loadingSpinner = document.getElementById('loading-spinner');
      var loadMoreWrapper = document.getElementById('load-more-wrapper');
      var productGrid = document.getElementById('product-grid');

      if (!productGrid) {
        dispatchLoadMoreComplete({ success: false, reason: 'missing-grid' });
        return;
      }

      var nextUrl = btn.dataset.nextUrl;
      if (!nextUrl) {
        dispatchLoadMoreComplete({ success: false, reason: 'missing-next-url' });
        return;
      }

      loadMoreInProgress = true;

      function finalize(detail) {
        loadMoreInProgress = false;
        dispatchLoadMoreComplete(detail);
      }

      if (prefetchCache.isReady && prefetchCache.url === nextUrl && prefetchCache.items) {
        var prefetchedBatchHtml = prefetchCache.itemsHtml || '';
        displayPrefetchedItems(productGrid, prefetchCache.items, function(addedCount) {
          var updatedNextUrl = prefetchCache.nextUrl || null;

          if (updatedNextUrl) {
            btn.dataset.nextUrl = updatedNextUrl;
            prefetchCache.url = null;
            prefetchCache.items = null;
            prefetchCache.itemsHtml = '';
            prefetchCache.isReady = false;
            prefetchNextPage(updatedNextUrl);
          } else if (loadMoreWrapper) {
            loadMoreWrapper.style.display = 'none';
          }

          btn.disabled = false;
          btn.setAttribute('aria-busy', 'false');
          if (loadingSpinner) loadingSpinner.style.display = 'none';

          markBatchLoaded(nextUrl, updatedNextUrl, addedCount, prefetchedBatchHtml);

          finalize({
            success: addedCount > 0,
            addedCount: addedCount,
            sourceUrl: nextUrl,
            nextUrl: updatedNextUrl,
            restored: restoreInProgress
          });
        });
        return;
      }

      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      if (loadingSpinner) loadingSpinner.style.display = 'inline-block';

      fetch(nextUrl)
        .then(function(response) {
          return response.text();
        })
        .then(function(html) {
          var parser = new DOMParser();
          var doc = parser.parseFromString(html, 'text/html');
          var newItems = Array.from(doc.querySelectorAll('#product-grid > li'));
          var batchItemsHtml = newItems
            .map(function(item) {
              return item.outerHTML;
            })
            .join('');
          var fragment = document.createDocumentFragment();

          newItems.forEach(function(item, index) {
            item.classList.add('load-more-fade-in');
            item.style.cssText = 'opacity:1;transform:translateY(0);animation-delay:' + index * 0.03 + 's';
            item.classList.remove('scroll-trigger');
            fragment.appendChild(item);
          });

          var newLoadMoreBtn = doc.querySelector('#load-more-btn');
          var updatedNextUrl = newLoadMoreBtn && newLoadMoreBtn.dataset.nextUrl ? newLoadMoreBtn.dataset.nextUrl : null;

          requestAnimationFrame(function() {
            if (newItems.length > 0) {
              productGrid.appendChild(fragment);
              triggerBSSPriceRefresh(productGrid);
              announceLoadMoreToScreenReader(newItems.length + ' new products loaded');
            }

            if (updatedNextUrl) {
              btn.dataset.nextUrl = updatedNextUrl;
              btn.disabled = false;
              btn.setAttribute('aria-busy', 'false');
              if (loadingSpinner) loadingSpinner.style.display = 'none';
              prefetchNextPage(updatedNextUrl);
            } else {
              if (loadMoreWrapper) loadMoreWrapper.style.display = 'none';
              if (loadingSpinner) loadingSpinner.style.display = 'none';
            }

            markBatchLoaded(nextUrl, updatedNextUrl, newItems.length, batchItemsHtml);

            finalize({
              success: newItems.length > 0,
              addedCount: newItems.length,
              sourceUrl: nextUrl,
              nextUrl: updatedNextUrl,
              restored: restoreInProgress
            });
          });
        })
        .catch(function(error) {
          console.error('Load more error:', error);
          btn.disabled = false;
          btn.setAttribute('aria-busy', 'false');
          if (loadingSpinner) loadingSpinner.style.display = 'none';
          finalize({
            success: false,
            addedCount: 0,
            sourceUrl: nextUrl,
            nextUrl: btn.dataset.nextUrl || null,
            restored: restoreInProgress,
            error: true
          });
        });
    }

    // Trigger BSS B2B and other third-party apps to process new price elements
    function triggerBSSPriceRefresh(container) {
      var sectionId = null;
      if (container && typeof container.closest === 'function') {
        var parentWithSection = container.closest('[data-section-id]');
        sectionId = parentWithSection ? parentWithSection.dataset.sectionId : null;
      }

      document.dispatchEvent(
        new CustomEvent('shopify:section:load', {
          bubbles: true,
          detail: { sectionId: sectionId }
        })
      );

      container.dispatchEvent(new CustomEvent('bss:content:updated', { bubbles: true }));

      if (typeof window.BSSB2B !== 'undefined' && typeof window.BSSB2B.refresh === 'function') {
        window.BSSB2B.refresh();
      }
      if (typeof window.BSSCommerce !== 'undefined' && typeof window.BSSCommerce.initPrices === 'function') {
        window.BSSCommerce.initPrices(container);
      }

      var priceElements = container.querySelectorAll('[bss-b2b-product-price]');
      priceElements.forEach(function(element) {
        element.setAttribute('data-bss-refresh', Date.now());
      });

      document.dispatchEvent(new CustomEvent('price:refresh', { detail: { container: container } }));

      if (typeof window.BssB2BTax !== 'undefined' && typeof window.BssB2BTax.calculate === 'function') {
        window.BssB2BTax.calculate();
      }
    }

    function announceLoadMoreToScreenReader(message) {
      var announcer = document.getElementById('load-more-announcer');
      if (!announcer) {
        announcer = document.createElement('div');
        announcer.id = 'load-more-announcer';
        announcer.className = 'load-more-sr-only';
        announcer.setAttribute('role', 'status');
        announcer.setAttribute('aria-live', 'polite');
        document.body.appendChild(announcer);
      }
      announcer.textContent = '';
      setTimeout(function() {
        announcer.textContent = message;
      }, 100);
    }

    function readProductContextMap() {
      return safeParseJSON(readSessionItem(PRODUCT_CONTEXT_KEY), {});
    }

    function writeProductContextMap(map) {
      writeSessionItem(PRODUCT_CONTEXT_KEY, JSON.stringify(map));
    }

    function saveProductCollectionContext(productPath) {
      if (!productPath) return;

      var contextMap = readProductContextMap();
      var now = Date.now();
      var contextMeta = getCollectionMeta();

      contextMap[productPath] = {
        collectionUrl: contextMeta.collectionUrl,
        collectionTitle: contextMeta.collectionTitle,
        timestamp: now
      };

      Object.keys(contextMap).forEach(function(key) {
        var item = contextMap[key];
        if (!item || !item.timestamp || now - item.timestamp > PRODUCT_CONTEXT_MAX_AGE_MS) {
          delete contextMap[key];
        }
      });

      var contextKeys = Object.keys(contextMap);
      if (contextKeys.length > 200) {
        contextKeys
          .sort(function(a, b) {
            var aTs = contextMap[a] && contextMap[a].timestamp ? contextMap[a].timestamp : 0;
            var bTs = contextMap[b] && contextMap[b].timestamp ? contextMap[b].timestamp : 0;
            return bTs - aTs;
          })
          .slice(200)
          .forEach(function(staleKey) {
            delete contextMap[staleKey];
          });
      }

      writeProductContextMap(contextMap);
    }

    function saveActiveProductContext(productPath) {
      var key = getCollectionStateKey();
      if (!key || !productPath) return;
      var contextMeta = getCollectionMeta();
      writeSessionItem(
        ACTIVE_PRODUCT_CONTEXT_KEY,
        JSON.stringify({
          productPath: productPath,
          collectionUrl: contextMeta.collectionUrl,
          collectionTitle: contextMeta.collectionTitle,
          timestamp: Date.now()
        })
      );

      setReturnIntent({
        collectionKey: key,
        collectionUrl: contextMeta.collectionUrl,
        collectionTitle: contextMeta.collectionTitle,
        productPath: productPath,
        mode: 'product-click',
        timestamp: Date.now()
      });
    }

    function extractProductHandle(productPath) {
      var parts = productPath.split('/').filter(Boolean);
      return parts.length ? parts[parts.length - 1] : '';
    }

    function handleProductLinkClick(event) {
      var productLink = event.target.closest('#product-grid a[href*="/products/"]');
      if (!productLink) return;
      if (productLink.closest('.quick-add, quick-add-bulk, quick-add-modal, product-form')) return;

      var productPath = normalizeProductPath(productLink.getAttribute('href'));
      if (!productPath) return;

      saveProductCollectionContext(productPath);
      saveActiveProductContext(productPath);

      persistCollectionState(
        {
          scrollY: Math.max(window.scrollY || 0, 0),
          clickedProductUrl: productPath,
          clickedProductPath: productPath,
          clickedProductHandle: extractProductHandle(productPath)
        },
        'product-click'
      );

      debugLog('Product clicked: ' + productPath);
    }

    function saveScrollStateIfNeeded(force) {
      var currentScrollY = Math.max(window.scrollY || 0, 0);
      if (!force && Math.abs(currentScrollY - lastSavedScrollY) < 120) return;
      lastSavedScrollY = currentScrollY;
      persistCollectionState({ scrollY: currentScrollY }, force ? 'pagehide' : 'scroll');
    }

    function handleScrollPersist() {
      if (scrollThrottleTimer) return;
      scrollThrottleTimer = setTimeout(function() {
        scrollThrottleTimer = null;
        saveScrollStateIfNeeded(false);
      }, 250);
    }

    function getHeaderOffset() {
      var header =
        document.querySelector('#shopify-section-header-group .section-header') ||
        document.querySelector('.section-header') ||
        document.querySelector('header');
      if (!header) return 80;
      return Math.round(header.getBoundingClientRect().height + 24);
    }

    function findProductElementInGrid(productPath) {
      if (!productPath) return null;
      var links = document.querySelectorAll('#product-grid a[href*="/products/"]');
      for (var i = 0; i < links.length; i += 1) {
        var candidatePath = normalizeProductPath(links[i].getAttribute('href'));
        if (candidatePath === productPath) {
          return links[i].closest('li') || links[i].closest('.grid__item') || links[i];
        }
      }
      return null;
    }

    function waitForNextFrame() {
      return new Promise(function(resolve) {
        requestAnimationFrame(function() {
          requestAnimationFrame(resolve);
        });
      });
    }

    function isScrollClose(targetY, tolerance) {
      return Math.abs((window.scrollY || 0) - Math.max(targetY, 0)) <= (tolerance || 80);
    }

    function restoreScrollPosition(savedState) {
      if (!savedState) {
        debugLog('Scroll already correct, no action');
        return { applied: false, reason: 'missing-state' };
      }

      var productPath = savedState.clickedProductPath || savedState.clickedProductUrl || '';
      var productElement = findProductElementInGrid(productPath);
      if (productElement) {
        var offset = getHeaderOffset();
        var targetTop = productElement.getBoundingClientRect().top + window.pageYOffset - offset;

        if (isScrollClose(targetTop, 90)) {
          debugLog('Scroll already correct, no action');
          return { applied: false, reason: 'already-correct-product' };
        }

        debugLog('Scrolling to clicked product');
        window.scrollTo(0, Math.max(targetTop, 0));

        setTimeout(function() {
          var adjustedTop = productElement.getBoundingClientRect().top + window.pageYOffset - offset;
          if (!isScrollClose(adjustedTop, 55)) {
            window.scrollTo(0, Math.max(adjustedTop, 0));
          }
        }, 220);

        return { applied: true, reason: 'product' };
      }

      if (typeof savedState.scrollY === 'number' && savedState.scrollY > 0) {
        if (isScrollClose(savedState.scrollY, 90)) {
          debugLog('Scroll already correct, no action');
          return { applied: false, reason: 'already-correct-scrollY' };
        }

        debugLog('Falling back to scrollY');
        window.scrollTo(0, savedState.scrollY);

        setTimeout(function() {
          if (!isScrollClose(savedState.scrollY, 55)) {
            window.scrollTo(0, savedState.scrollY);
          }
        }, 220);

        return { applied: true, reason: 'scrollY' };
      }

      debugLog('Scroll already correct, no action');
      return { applied: false, reason: 'no-scroll-target' };
    }

    async function applyScrollRestorationOnly(savedState, restoreOperation) {
      debugLog('Applying scroll restoration only');
      logRestoreStage(restoreOperation, 'first scroll pending', {
        mode: 'scroll-only'
      });
      await waitForNextFrame();
      var scrollResult = restoreScrollPosition(savedState);
      logRestoreStage(restoreOperation, 'first scroll applied', {
        mode: 'scroll-only',
        applied: Boolean(scrollResult && scrollResult.applied),
        scrollReason: scrollResult && scrollResult.reason ? scrollResult.reason : 'unknown'
      });
      logTotalReturnToProduct(restoreOperation, {
        mode: 'scroll-only',
        applied: Boolean(scrollResult && scrollResult.applied),
        scrollReason: scrollResult && scrollResult.reason ? scrollResult.reason : 'unknown'
      });
    }

    function setGridRestoringState(isRestoring) {
      var grid = document.getElementById('product-grid');
      if (!grid) return;
      if (isRestoring) {
        grid.setAttribute('data-collection-restoring', 'true');
      } else {
        grid.removeAttribute('data-collection-restoring');
      }
    }

    function applyLoadMoreControlState(nextPageUrl) {
      var btn = getLoadMoreButton();
      var wrapper = document.getElementById('load-more-wrapper');

      if (nextPageUrl) {
        if (btn) {
          btn.dataset.nextUrl = nextPageUrl;
          btn.disabled = false;
          btn.setAttribute('aria-busy', 'false');
        }
        if (wrapper) {
          wrapper.style.display = '';
        }
      } else {
        if (wrapper) {
          wrapper.style.display = 'none';
        }
      }
    }

    function extractBatchFromHtml(pageUrl, html) {
      if (!html) return null;
      var parser = new DOMParser();
      var doc = parser.parseFromString(html, 'text/html');
      var items = Array.from(doc.querySelectorAll('#product-grid > li'));
      if (!items.length) return null;

      var nextBtn = doc.querySelector('#load-more-btn');
      return {
        pageUrl: normalizeCollectionUrl(pageUrl),
        itemsHtml: items
          .map(function(item) {
            return item.outerHTML;
          })
          .join(''),
        nextPageUrl: nextBtn && nextBtn.dataset.nextUrl ? nextBtn.dataset.nextUrl : null,
        timestamp: Date.now()
      };
    }

    function getExpectedLoadedBatchUrls(savedState) {
      if (!savedState || !Array.isArray(savedState.loadedBatchUrls)) return [];
      return savedState.loadedBatchUrls
        .map(function(url) {
          return normalizeCollectionUrl(url);
        })
        .filter(Boolean);
    }

    function buildBatchCacheMap(savedState) {
      var map = {};
      if (!savedState || !Array.isArray(savedState.batchCache)) return map;
      savedState.batchCache.forEach(function(batch) {
        if (!batch || !batch.pageUrl || !batch.itemsHtml) return;
        map[normalizeCollectionUrl(batch.pageUrl)] = batch;
      });
      return map;
    }

    function appendBatchHtmlToGrid(orderedBatches) {
      var productGrid = document.getElementById('product-grid');
      if (!productGrid) return { pages: 0, items: 0 };

      var fragment = document.createDocumentFragment();
      var insertedItems = 0;

      orderedBatches.forEach(function(batch) {
        if (!batch || !batch.itemsHtml) return;
        var wrapper = document.createElement('div');
        wrapper.innerHTML = '<ul>' + batch.itemsHtml + '</ul>';
        var items = wrapper.querySelectorAll('li');
        insertedItems += items.length;
        items.forEach(function(item) {
          item.classList.remove('scroll-trigger');
          fragment.appendChild(item);
        });
      });

      productGrid.appendChild(fragment);
      triggerBSSPriceRefresh(productGrid);

      return {
        pages: orderedBatches.length,
        items: insertedItems
      };
    }

    async function fetchKnownBatchUrls(urls, restoreOperation, reason) {
      if (!urls.length) return [];

      var fetchStart = performance.now();
      perfEventLog('network fallback START', {
        restoreId: restoreOperation && restoreOperation.id ? restoreOperation.id : 'unknown',
        reason: reason || 'missing-cached-batches',
        requestCount: urls.length,
        missingPageUrls: urls.slice()
      });

      var results = await Promise.all(
        urls.map(function(url) {
          return fetch(url)
            .then(function(response) {
              if (!response.ok) return null;
              return response.text();
            })
            .then(function(html) {
              return html ? extractBatchFromHtml(url, html) : null;
            })
            .catch(function() {
              return null;
            });
        })
      );

      var fetchedBatches = results.filter(Boolean);
      perfEventLog('network fallback END', {
        restoreId: restoreOperation && restoreOperation.id ? restoreOperation.id : 'unknown',
        reason: reason || 'missing-cached-batches',
        elapsedMs: Math.round(performance.now() - fetchStart),
        requestCount: urls.length,
        fetchedUrls: fetchedBatches.map(function(batch) {
          return normalizeCollectionUrl(batch.pageUrl);
        })
      });

      return fetchedBatches;
    }

    async function restoreUsingCachedOrKnownNetworkBatches(savedState, restoreOperation) {
      var expectedUrls = getExpectedLoadedBatchUrls(savedState);
      if (!expectedUrls.length) {
        return {
          restored: false,
          reason: 'no-known-batch-urls'
        };
      }

      var cacheMap = buildBatchCacheMap(savedState);
      var missingUrls = expectedUrls.filter(function(url) {
        return !cacheMap[url];
      });

      logRestoreStage(restoreOperation, 'cache availability determined', {
        expectedBatchUrls: expectedUrls.length,
        cachedBatchUrls: expectedUrls.length - missingUrls.length,
        missingBatchUrls: missingUrls.length
      });

      if (missingUrls.length) {
        logRestoreStage(restoreOperation, 'missing network requests started', {
          missingPageUrls: missingUrls.slice(),
          requestCount: missingUrls.length
        });

        var networkBatches = await fetchKnownBatchUrls(
          missingUrls,
          restoreOperation,
          'missing-cached-batches'
        );

        logRestoreStage(restoreOperation, 'missing network responses completed', {
          fetchedBatchCount: networkBatches.length,
          fetchedUrls: networkBatches.map(function(batch) {
            return normalizeCollectionUrl(batch.pageUrl);
          })
        });

        networkBatches.forEach(function(batch) {
          cacheMap[normalizeCollectionUrl(batch.pageUrl)] = batch;
          cacheBatchForCurrentState(batch.pageUrl, batch.itemsHtml, batch.nextPageUrl || null);
        });
      }

      var orderedBatches = expectedUrls
        .map(function(url) {
          return cacheMap[url] || null;
        })
        .filter(Boolean);

      if (!orderedBatches.length) {
        return {
          restored: false,
          reason: 'no-restorable-batches'
        };
      }

      setGridRestoringState(true);
      var insertStart = performance.now();
      var inserted = appendBatchHtmlToGrid(orderedBatches);
      perfLog('cards inserted', performance.now() - insertStart);
      logRestoreStage(restoreOperation, 'cached/network cards inserted', {
        insertedPages: inserted.pages,
        insertedItems: inserted.items,
        mode: missingUrls.length > 0 ? 'network-fallback' : 'cached-dom'
      });
      setGridRestoringState(false);

      runtimeLoadedPages = inserted.pages;
      loadedBatchUrls = orderedBatches.map(function(batch) {
        return normalizeCollectionUrl(batch.pageUrl);
      });

      var finalNextUrl = orderedBatches[orderedBatches.length - 1].nextPageUrl || savedState.nextPageUrl || null;
      applyLoadMoreControlState(finalNextUrl);

      return {
        restored: true,
        usedNetwork: missingUrls.length > 0,
        nextPageUrl: finalNextUrl
      };
    }

    function shouldInterveneAfterBFCache(savedState) {
      if (!savedState) return false;
      var currentY = Math.max(window.scrollY || 0, 0);
      if (currentY > 60) return false;
      if (typeof savedState.scrollY === 'number' && savedState.scrollY > 240) return true;
      if (savedState.clickedProductPath || savedState.clickedProductUrl) return true;
      return false;
    }

    function triggerLoadMoreAndWait() {
      return new Promise(function(resolve) {
        var btn = getLoadMoreButton();
        if (!btn || !btn.dataset.nextUrl || btn.disabled) {
          resolve({ success: false, reason: 'no-next-page' });
          return;
        }

        var completed = false;
        var timeoutId = null;

        function cleanup() {
          if (timeoutId) clearTimeout(timeoutId);
          document.removeEventListener('baystew:load-more-complete', onLoadMoreComplete);
        }

        function onLoadMoreComplete(completeEvent) {
          if (completed) return;
          completed = true;
          cleanup();
          resolve(completeEvent.detail || { success: false, reason: 'unknown' });
        }

        document.addEventListener('baystew:load-more-complete', onLoadMoreComplete);
        timeoutId = setTimeout(function() {
          if (completed) return;
          completed = true;
          cleanup();
          resolve({ success: false, reason: 'timeout' });
        }, 10000);

        btn.click();
      });
    }

    function hasDomAlreadyRestored(savedState) {
      if (!savedState || savedState.loadedPages < 1) return false;
      var btn = getLoadMoreButton();
      var currentNextUrl = btn && btn.dataset.nextUrl ? normalizeCollectionUrl(btn.dataset.nextUrl) : null;
      var savedNextUrl = savedState.nextPageUrl ? normalizeCollectionUrl(savedState.nextPageUrl) : null;

      if (currentNextUrl === savedNextUrl) {
        return true;
      }

      if (!btn && !savedNextUrl) {
        return true;
      }

      return false;
    }

    async function restoreCollectionStateIfNeeded(triggerSource) {
      var restoreOperation = createRestoreOperation(triggerSource);
      logRestoreStage(restoreOperation, 'restore attempt start', {
        navigationType: getNavigationType() || 'unknown'
      });
      if (typeof domReadyPerfAt === 'number') {
        logRestoreStage(restoreOperation, 'collection DOM ready', {
          domReadySinceInitMs: Math.round(domReadyPerfAt - scriptInitPerfAt),
          domReadySinceBaselineMs: Math.round(domReadyPerfAt - restoreOperation.baselineAt)
        });
      }

      var key = getCollectionStateKey();
      if (!key) return;
      if (restoreOperationInProgress) {
        logRestoreStage(restoreOperation, 'restore skipped duplicate', {
          key: key,
          activeRestoreId: activeRestoreOperationId || ''
        });
        return;
      }
      if (restoreInProgress) {
        logRestoreStage(restoreOperation, 'restore skipped in-progress', {
          key: key,
          activeRestoreId: activeRestoreOperationId || ''
        });
        return;
      }
      if (restoreAttemptedForKey === key) {
        logRestoreStage(restoreOperation, 'restore skipped already-attempted-key', {
          key: key
        });
        return;
      }

      restoreOperationInProgress = true;
      activeRestoreOperationId = restoreOperation.id;

      restoreAttemptedForKey = key;
      debugLog('State key: ' + key);
      logRestoreStage(restoreOperation, 'state read start', {
        key: key
      });

      try {
        var restoreDecision = shouldRestoreForVisit(key);
        logRestoreStage(restoreOperation, 'return intent resolved', {
          shouldRestore: Boolean(restoreDecision.shouldRestore),
          reason: restoreDecision.reason || 'unknown',
          consumeIntent: Boolean(restoreDecision.consumeIntent)
        });

        if (!restoreDecision.shouldRestore) {
          if (restoreDecision.reason === 'intent-present-but-not-return-navigation') {
            debugLog('Skipping restore for normal fresh visit');
          }
          if (restoreDecision.consumeIntent) {
            consumeReturnIntent();
          }
          return;
        }

        var savedState = getCollectionState();
        logRestoreStage(restoreOperation, 'state read complete', {
          hasState: Boolean(savedState),
          savedLoadedPages: savedState ? savedState.loadedPages : 0,
          savedBatchCacheCount: savedState && Array.isArray(savedState.batchCache) ? savedState.batchCache.length : 0
        });
        if (!savedState) {
          if (restoreDecision.consumeIntent) {
            consumeReturnIntent();
          }
          return;
        }

        debugLog('Restoring state:', savedState);

        if (hasDomAlreadyRestored(savedState)) {
          debugLog('DOM already restored, checking position');
          logRestoreStage(restoreOperation, 'cache availability determined', {
            mode: 'dom-already-restored',
            missingBatchUrls: 0
          });
          await applyScrollRestorationOnly(savedState, restoreOperation);
          perfLog('cached DOM restore', performance.now() - restoreOperation.startedAt);
          if (restoreDecision.consumeIntent) {
            consumeReturnIntent();
          }
          return;
        }

        var cachedRestoreResult = await restoreUsingCachedOrKnownNetworkBatches(savedState, restoreOperation);
        if (cachedRestoreResult.restored) {
          var scrollStart = performance.now();
          var clickedPath = savedState.clickedProductPath || savedState.clickedProductUrl || '';
          var anchorElement = findProductElementInGrid(clickedPath);
          logRestoreStage(restoreOperation, 'clicked-product anchor found', {
            found: Boolean(anchorElement),
            clickedProductPath: clickedPath || ''
          });
          logRestoreStage(restoreOperation, 'first scroll pending', {
            mode: cachedRestoreResult.usedNetwork ? 'network-fallback' : 'cached-dom'
          });
          await waitForNextFrame();
          var scrollResult = restoreScrollPosition(savedState);
          logRestoreStage(restoreOperation, 'first scroll applied', {
            mode: cachedRestoreResult.usedNetwork ? 'network-fallback' : 'cached-dom',
            applied: Boolean(scrollResult && scrollResult.applied),
            scrollReason: scrollResult && scrollResult.reason ? scrollResult.reason : 'unknown'
          });
          perfLog('scroll restored', performance.now() - scrollStart);
          if (cachedRestoreResult.usedNetwork) {
            perfLog('network fallback', performance.now() - restoreOperation.startedAt);
          } else {
            perfLog('cached DOM restore', performance.now() - restoreOperation.startedAt);
          }
          logTotalReturnToProduct(restoreOperation, {
            mode: cachedRestoreResult.usedNetwork ? 'network-fallback' : 'cached-dom',
            usedNetwork: Boolean(cachedRestoreResult.usedNetwork),
            applied: Boolean(scrollResult && scrollResult.applied),
            scrollReason: scrollResult && scrollResult.reason ? scrollResult.reason : 'unknown'
          });

          if (restoreDecision.consumeIntent) {
            consumeReturnIntent();
          }

          persistCollectionState(
            {
              nextPageUrl: cachedRestoreResult.nextPageUrl
            },
            cachedRestoreResult.usedNetwork ? 'restore-network' : 'restore-cached'
          );
          return;
        }

        var targetLoads = Math.max(parseInt(savedState.loadedPages, 10) || 0, 0);
        var replayStart = performance.now();

        restoreInProgress = true;
        setGridRestoringState(true);
        try {
          for (var i = 0; i < targetLoads; i += 1) {
            debugLog('Restoring page ' + (i + 2));
            var result = await triggerLoadMoreAndWait();
            if (!result || !result.success) {
              debugLog('Restore failed gracefully: ' + ((result && result.reason) || 'unknown'));
              break;
            }
          }

          var replayScrollStart = performance.now();
          var replayClickedPath = savedState.clickedProductPath || savedState.clickedProductUrl || '';
          var replayAnchorElement = findProductElementInGrid(replayClickedPath);
          logRestoreStage(restoreOperation, 'clicked-product anchor found', {
            found: Boolean(replayAnchorElement),
            clickedProductPath: replayClickedPath || ''
          });
          logRestoreStage(restoreOperation, 'first scroll pending', {
            mode: 'load-more-replay'
          });
          await waitForNextFrame();
          var replayScrollResult = restoreScrollPosition(savedState);
          logRestoreStage(restoreOperation, 'first scroll applied', {
            mode: 'load-more-replay',
            applied: Boolean(replayScrollResult && replayScrollResult.applied),
            scrollReason: replayScrollResult && replayScrollResult.reason ? replayScrollResult.reason : 'unknown'
          });
          perfLog('scroll restored', performance.now() - replayScrollStart);
          debugLog('Restore complete');
          logTotalReturnToProduct(restoreOperation, {
            mode: 'load-more-replay',
            applied: Boolean(replayScrollResult && replayScrollResult.applied),
            scrollReason: replayScrollResult && replayScrollResult.reason ? replayScrollResult.reason : 'unknown'
          });
        } finally {
          setGridRestoringState(false);
          restoreInProgress = false;
        }

        perfLog('load-more replay', performance.now() - replayStart);
        perfLog('network fallback', performance.now() - restoreOperation.startedAt);

        if (restoreDecision.consumeIntent) {
          consumeReturnIntent();
        }
        persistCollectionState({}, 'restore');
      } finally {
        restoreOperationInProgress = false;
        activeRestoreOperationId = null;
      }
    }

    function schedulePrefetch(delayMs) {
      setTimeout(function() {
        var btn = getLoadMoreButton();
        if (btn && btn.dataset.nextUrl) {
          prefetchNextPage(btn.dataset.nextUrl);
        }
      }, delayMs);
    }

    function resetRuntimeStateForCurrentGrid() {
      runtimeLoadedPages = 0;
      loadedBatchUrls = [];
      lastSavedScrollY = Math.max(window.scrollY || 0, 0);
    }

    if (!loadMoreListenerAttached) {
      document.addEventListener('click', handleLoadMoreClick);
      loadMoreListenerAttached = true;
    }

    document.addEventListener('click', handleProductLinkClick, true);
    window.addEventListener('scroll', handleScrollPersist, { passive: true });
    window.addEventListener('pagehide', function() {
      saveScrollStateIfNeeded(true);
    });

    window.addEventListener('pageshow', function(pageShowEvent) {
      var bfcachePerfStart = performance.now();
      lastPageShowPerfAt = performance.now();
      logBackForwardDiagnostics(pageShowEvent);

      if (pageShowEvent.persisted) {
        debugLog('Browser back detected');
        restoredFromBFCache = true;
        debugLog('bfcache restored page - skipping AJAX restore');

        var persistedSavedState = getCollectionState();
        if (persistedSavedState && shouldInterveneAfterBFCache(persistedSavedState)) {
          debugLog('DOM already restored, checking position');
          var bfcacheRestoreOperation = createRestoreOperation('pageshow-bfcache');
          logRestoreStage(bfcacheRestoreOperation, 'collection DOM ready', {
            readyState: document.readyState || 'unknown'
          });
          applyScrollRestorationOnly(persistedSavedState, bfcacheRestoreOperation);
        } else {
          debugLog('Scroll already correct, no action');
        }

        perfLog('bfcache restore', performance.now() - bfcachePerfStart);

        var key = getCollectionStateKey();
        var intent = getReturnIntent();
        if (intent && key && intent.collectionKey === key) {
          consumeReturnIntent();
        }
        return;
      }
      restoreCollectionStateIfNeeded('pageshow');
    });

    function onCollectionPageReady() {
      domReadyPerfAt = performance.now();
      pruneCollectionStateStorage();
      resetRuntimeStateForCurrentGrid();
      browserBackDetected = getNavigationType() === 'back_forward';
      if (browserBackDetected) {
        debugLog('Browser back detected');
      }
      restoreCollectionStateIfNeeded('ready');
      schedulePrefetch(1500);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', onCollectionPageReady);
    } else {
      onCollectionPageReady();
    }

    // Reset state cache and prefetch after AJAX filter/sort replacements.
    document.addEventListener('facets:updated', function() {
      debugLog('Facet/sort URL changed');
      resetPrefetchCache();
      resetRuntimeStateForCurrentGrid();
      restoreAttemptedForKey = null;
      restoreCollectionStateIfNeeded('facets-updated');
      schedulePrefetch(1000);
    });
  })();
</script>

