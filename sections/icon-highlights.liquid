{{ 'section-icon-highlights.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout_max_width = settings.page_width
  case section.settings.content_width
    when 'narrow'
      assign layout_max_width = 900
    when 'standard'
      assign layout_max_width = 1200
    when 'wide'
      assign layout_max_width = 1440
    when 'full'
      assign layout_max_width = 2400
  endcase

  assign desktop_columns = section.settings.desktop_columns
  if section.settings.desktop_columns == 'auto'
    assign desktop_columns = section.blocks.size
    if desktop_columns < 1
      assign desktop_columns = 3
    endif
  endif

  assign mobile_padding_top = section.settings.padding_top | times: 0.75 | round: 0
  assign mobile_padding_bottom = section.settings.padding_bottom | times: 0.75 | round: 0
  if section.settings.use_mobile_padding
    assign mobile_padding_top = section.settings.mobile_padding_top
    assign mobile_padding_bottom = section.settings.mobile_padding_bottom
  endif

  assign heading_size_class = 'h1'
  case section.settings.heading_size
    when 'small'
      assign heading_size_class = 'h2'
    when 'large'
      assign heading_size_class = 'h0'
  endcase

  assign show_header = false
  if section.settings.show_heading and section.settings.heading != blank
    assign show_header = true
  endif
  if section.settings.description != blank
    assign show_header = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .icon-highlights {
    --ih-layout-max-width: {{ layout_max_width }}px;
    --ih-user-max-width: {{ section.settings.max_content_width }}px;
    --ih-desktop-columns: {{ desktop_columns }};
    --ih-tablet-columns: {{ section.settings.tablet_columns }};
    --ih-mobile-columns: {{ section.settings.mobile_columns }};
    --ih-horizontal-gap: {{ section.settings.horizontal_gap }}px;
    --ih-vertical-gap: {{ section.settings.vertical_gap }}px;
    --ih-padding-top-mobile: {{ mobile_padding_top }}px;
    --ih-padding-bottom-mobile: {{ mobile_padding_bottom }}px;
    --ih-padding-top-desktop: {{ section.settings.padding_top }}px;
    --ih-padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
    --ih-heading-bottom-spacing: {{ section.settings.heading_bottom_spacing }}px;
    --ih-section-heading-weight: {{ section.settings.heading_weight }};
    --ih-section-border-color: {{ section.settings.section_border_color }};
    --ih-section-border-width: {{ section.settings.section_border_width }}px;
    --ih-separator-color: {{ section.settings.separator_color }};
    --ih-separator-thickness: {{ section.settings.separator_thickness }}px;
    --ih-card-background-color: {{ section.settings.card_background_color }};
    --ih-alt-card-background-color: {{ section.settings.alternate_card_background_color }};
    --ih-icon-size: {{ section.settings.icon_size }}px;
    --ih-icon-container-size: {{ section.settings.icon_container_size }}px;
    --ih-icon-color: {{ section.settings.icon_color }};
    --ih-icon-background-color: {{ section.settings.icon_container_background_color }};
    --ih-icon-border-color: {{ section.settings.icon_border_color }};
    --ih-icon-border-width: {{ section.settings.icon_border_thickness }}px;
    --ih-icon-corner-radius: {{ section.settings.icon_container_corner_radius }}px;
    --ih-item-heading-size: {{ section.settings.block_heading_size }}px;
    --ih-item-heading-weight: {{ section.settings.block_heading_weight }};
    --ih-item-description-size: {{ section.settings.block_description_size }}px;
    --ih-item-description-line-height: {{ section.settings.block_description_line_height | divided_by: 100.0 }};
    --ih-icon-heading-spacing: {{ section.settings.icon_heading_spacing }}px;
    --ih-heading-description-spacing: {{ section.settings.heading_description_spacing }}px;
  }
{%- endstyle -%}

<section
  class="icon-highlights color-{{ section.settings.color_scheme }} gradient icon-highlights--mobile-{{ section.settings.mobile_content_alignment }} icon-highlights--desktop-{{ section.settings.desktop_content_alignment }}{% if section.settings.equal_width_columns %} icon-highlights--equal-columns{% else %} icon-highlights--natural-columns{% endif %}{% if section.settings.enable_custom_background %} icon-highlights--custom-background{% endif %}{% if section.settings.show_section_border %} icon-highlights--section-border{% endif %}{% if section.settings.show_top_separator %} icon-highlights--separator-top{% endif %}{% if section.settings.show_bottom_separator %} icon-highlights--separator-bottom{% endif %}{% if section.settings.enable_card_background %} icon-highlights--card-background{% endif %}{% if section.settings.enable_alternate_card_background %} icon-highlights--alternate-card-background{% endif %}"
  {% if section.settings.enable_custom_background %}
    style="--ih-custom-background-color: {{ section.settings.custom_background_color }};"
  {% endif %}
>
  <div class="icon-highlights__container{% if section.settings.content_width == 'full' %} icon-highlights__container--full{% endif %}">
    <div class="icon-highlights__content">
      {%- if show_header -%}
        <header class="icon-highlights__header icon-highlights__header--{{ section.settings.heading_alignment }}">
          {%- if section.settings.show_heading and section.settings.heading != blank -%}
            <h2
              class="icon-highlights__heading title inline-richtext {{ heading_size_class }}"
              {% if section.settings.use_custom_heading_color %}
                style="color: {{ section.settings.heading_color }};"
              {% endif %}
            >
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <div
              class="icon-highlights__description icon-highlights__description--{{ section.settings.description_size }} rte"
              {% if section.settings.use_custom_description_color %}
                style="color: {{ section.settings.description_color }};"
              {% endif %}
            >
              {{ section.settings.description }}
            </div>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if request.design_mode and section.blocks.size < 3 -%}
        <p class="icon-highlights__editor-note" role="note">
          Add at least 3 Icon highlight blocks for the intended layout.
        </p>
      {%- endif -%}

      <ul class="icon-highlights__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign use_block_icon_styles = false
            if block.settings.use_global_icon_style == false
              assign use_block_icon_styles = true
            endif

            assign resolved_icon_size = section.settings.icon_size
            assign resolved_icon_color = section.settings.icon_color
            assign resolved_icon_background_enabled = section.settings.enable_icon_background
            assign resolved_icon_background_color = section.settings.icon_container_background_color
            assign resolved_icon_shape = section.settings.icon_container_shape
            assign resolved_icon_border_enabled = section.settings.enable_icon_border
            assign resolved_icon_border_color = section.settings.icon_border_color
            assign resolved_icon_border_width = section.settings.icon_border_thickness
            assign resolved_icon_corner_radius = section.settings.icon_container_corner_radius

            if use_block_icon_styles
              assign resolved_icon_size = block.settings.icon_size
              assign resolved_icon_color = block.settings.svg_icon_color
              assign resolved_icon_background_enabled = block.settings.icon_background_enabled
              assign resolved_icon_background_color = block.settings.icon_container_background_color
              assign resolved_icon_border_enabled = block.settings.icon_border_enabled
              assign resolved_icon_border_color = block.settings.icon_border_color
              assign resolved_icon_border_width = block.settings.icon_border_thickness
              assign resolved_icon_corner_radius = block.settings.icon_container_corner_radius
              if block.settings.icon_container_shape != 'inherit'
                assign resolved_icon_shape = block.settings.icon_container_shape
              endif
            endif

            assign resolved_container_size = section.settings.icon_container_size
            if resolved_icon_shape != 'none' and resolved_icon_size > resolved_container_size
              assign resolved_container_size = resolved_icon_size | plus: 12
            endif

            assign icon_heading_spacing = section.settings.icon_heading_spacing
            assign heading_description_spacing = section.settings.heading_description_spacing
            if block.settings.use_custom_spacing
              assign icon_heading_spacing = block.settings.icon_heading_spacing
              assign heading_description_spacing = block.settings.heading_description_spacing
            endif

            assign block_alignment_class = ''
            if block.settings.text_alignment_override != 'inherit'
              assign block_alignment_class = ' icon-highlights__grid-item--align-' | append: block.settings.text_alignment_override
            endif

            assign icon_image_width = resolved_icon_size | times: 2
            if icon_image_width < 64
              assign icon_image_width = 64
            endif

            assign use_icon_image = false
            if block.settings.icon_source == 'image' and block.settings.icon_image != blank
              assign use_icon_image = true
            endif

            assign has_link = false
            if block.settings.link != blank
              assign has_link = true
            endif

            assign open_whole_block_link = false
            if has_link and block.settings.link_style == 'whole_block'
              assign open_whole_block_link = true
            endif

            assign heading_color = blank
            if block.settings.override_heading_color
              assign heading_color = block.settings.heading_color
            endif

            assign description_color = blank
            if block.settings.override_description_color
              assign description_color = block.settings.description_color
            endif

            assign custom_card_background_enabled = false
            if block.settings.custom_card_background_enabled
              assign custom_card_background_enabled = true
            endif

            assign block_link_label = block.settings.link_label | strip
            if block_link_label == blank
              assign block_link_label = 'Learn more'
            endif
          -%}

          <li
            class="icon-highlights__grid-item{{ block_alignment_class }}{% if custom_card_background_enabled %} icon-highlights__grid-item--custom-card-background{% endif %}"
            style="
              --ih-block-icon-size: {{ resolved_icon_size }}px;
              --ih-block-icon-container-size: {{ resolved_container_size }}px;
              --ih-block-icon-color: {{ resolved_icon_color }};
              --ih-block-icon-background-color: {{ resolved_icon_background_color }};
              --ih-block-icon-border-color: {{ resolved_icon_border_color }};
              --ih-block-icon-border-width: {{ resolved_icon_border_width }}px;
              --ih-block-icon-corner-radius: {{ resolved_icon_corner_radius }}px;
              --ih-block-icon-heading-spacing: {{ icon_heading_spacing }}px;
              --ih-block-heading-description-spacing: {{ heading_description_spacing }}px;
              {% if heading_color != blank %}--ih-item-heading-color: {{ heading_color }};{% endif %}
              {% if description_color != blank %}--ih-item-description-color: {{ description_color }};{% endif %}
              {% if custom_card_background_enabled %}--ih-item-custom-card-background: {{ block.settings.custom_card_background_color }};{% endif %}
            "
            {{ block.shopify_attributes }}
          >
            {%- if open_whole_block_link -%}
              <a
                class="icon-highlights__item icon-highlights__item-link"
                href="{{ block.settings.link }}"
                {% if block.settings.open_new_tab %}
                  target="_blank" rel="noopener noreferrer"
                {% endif %}
              >
            {%- else -%}
              <div class="icon-highlights__item">
            {%- endif -%}
                <div class="icon-highlights__icon-wrapper">
                  <span
                    class="icon-highlights__icon-container icon-highlights__icon-container--{{ resolved_icon_shape | replace: '_', '-' }}{% if resolved_icon_background_enabled %} icon-highlights__icon-container--has-background{% endif %}{% if resolved_icon_border_enabled %} icon-highlights__icon-container--has-border{% endif %}"
                  >
                    {%- if use_icon_image -%}
                      {%- assign icon_alt = block.settings.icon_image.alt | default: block.settings.heading | strip_html -%}
                      {{
                        block.settings.icon_image
                        | image_url: width: icon_image_width
                        | image_tag:
                          loading: 'lazy',
                          class: 'icon-highlights__icon-image',
                          alt: icon_alt
                      }}
                    {%- else -%}
                      {%- render 'icon-highlights-icon', icon: block.settings.builtin_icon, class: 'icon-highlights__icon-svg' -%}
                    {%- endif -%}
                  </span>
                </div>

                {%- if block.settings.heading != blank -%}
                  <h3 class="icon-highlights__item-heading">
                    {{ block.settings.heading }}
                  </h3>
                {%- endif -%}

                {%- unless block.settings.hide_description -%}
                  {%- if block.settings.description != blank -%}
                    <div class="icon-highlights__item-description rte">
                      {{ block.settings.description }}
                    </div>
                  {%- endif -%}
                {%- endunless -%}

                {%- if has_link and block.settings.link_style == 'text_link' -%}
                  <a
                    class="icon-highlights__text-link"
                    href="{{ block.settings.link }}"
                    {% if block.settings.open_new_tab %}
                      target="_blank" rel="noopener noreferrer"
                    {% endif %}
                  >
                    {{ block_link_label | escape }}
                  </a>
                {%- elsif open_whole_block_link and block.settings.link_label != blank -%}
                  <span class="icon-highlights__link-label" aria-hidden="true">
                    {{ block.settings.link_label | escape }}
                  </span>
                {%- endif -%}
            {%- if open_whole_block_link -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Icon Highlights",
  "tag": "section",
  "class": "section section-icon-highlights",
  "max_blocks": 5,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show section heading",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Why choose us"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_weight",
      "label": "Heading weight",
      "min": 400,
      "max": 800,
      "step": 100,
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "use_custom_heading_color",
      "label": "Use custom heading color",
      "default": false
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1F1F1F"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "description_size",
      "label": "Description size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "use_custom_description_color",
      "label": "Use custom description color",
      "default": false
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#4A4A4A"
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "label": "Spacing below heading",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "theme_default",
      "options": [
        {
          "value": "theme_default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_content_width",
