{{ 'favorites.css' | asset_url | stylesheet_tag }}
{{ 'save-for-later.css' | asset_url | stylesheet_tag }}
<script src="{{ 'favorites.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'save-for-later.js' | asset_url }}" defer="defer"></script>

<div
  class="bs-favorites"
  data-bs-favorites-page
  data-logged-in="{% if customer %}true{% else %}false{% endif %}"
>
  <h1 class="bs-favorites__title">{{ section.settings.title | default: 'My Favorites' }}</h1>

  {%- unless customer -%}
    <div class="bs-favorites__signin">
      <p>{{ section.settings.signin_text | default: 'Please sign in to view and manage your favorites.' }}</p>
      <a class="button button--primary" href="{{ routes.account_login_url }}?checkout_url={{ request.path | url_encode }}">
        {{ 'customer.log_in' | t }}
      </a>
    </div>
  {%- else -%}

    {%- comment -%} Tab navigation {%- endcomment -%}
    <nav class="bs-page-tabs" data-bs-page-tabs aria-label="Favorites navigation">
      <button type="button" class="bs-page-tabs__btn" data-bs-tab="favorites" aria-selected="true">
        Favorites
      </button>
      <button type="button" class="bs-page-tabs__btn" data-bs-tab="saved" aria-selected="false">
        Saved for Later
      </button>
    </nav>

    {%- comment -%} Favorites tab panel {%- endcomment -%}
    <div data-bs-tab-panel="favorites">
      <div data-bs-favorites-root>
        <p class="bs-favorites__loading">Loading your favorites…</p>
      </div>

    </div>

    {%- comment -%} Saved for Later tab panel {%- endcomment -%}
    <div data-bs-tab-panel="saved" hidden>
      <div data-bs-sfl-root>
        <p class="bs-favorites__loading">Loading saved items…</p>
      </div>
    </div>

  {%- endunless -%}
</div>

{% schema %}
{
  "name": "Favorites",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "My Favorites"
    },
    {
      "type": "text",
      "id": "signin_text",
      "label": "Sign-in prompt",
      "default": "Please sign in to view and manage your favorites."
    }
  ],
  "presets": [
    {
      "name": "Favorites"
    }
  ]
}
{% endschema %}
