{%- liquid
  assign renderable_item_count = 0
  assign desktop_top_spacing = section.settings.desktop_spacing_top | default: 24
  assign desktop_bottom_spacing = section.settings.desktop_spacing_bottom | default: 0
  assign mobile_top_spacing = section.settings.mobile_spacing_top | default: 20
  assign mobile_bottom_spacing = section.settings.mobile_spacing_bottom | default: 0
  assign desktop_columns = section.settings.desktop_columns | default: 6
  assign tablet_columns = section.settings.tablet_columns | default: 3
  assign mobile_columns = section.settings.mobile_columns | default: 2
  assign content_max_width = section.settings.max_content_width | default: 1200

  assign image_ratio_value = '4 / 3'
  case section.settings.image_ratio
    when 'square'
      assign image_ratio_value = '1 / 1'
    when 'portrait'
      assign image_ratio_value = '3 / 4'
    when 'adapt'
      assign image_ratio_value = 'auto'
  endcase

  for block in section.blocks
    assign selected_collection = block.settings.collection
    assign custom_link = block.settings.link

    assign render_block = false
    if custom_link != blank or selected_collection != blank
      assign render_block = true
    endif

    if render_block
      assign renderable_item_count = renderable_item_count | plus: 1
    elsif request.design_mode
      assign renderable_item_count = renderable_item_count | plus: 1
    endif
  endfor

  assign should_render_section = false
  if renderable_item_count > 0 or request.design_mode
    assign should_render_section = true
  endif
-%}

{%- if should_render_section -%}
  <script src="{{ 'navigation-grid-equalizer.js' | asset_url }}" defer="defer"></script>

  {%- style -%}
    #shopify-section-{{ section.id }} .navigation-grid {
      --clg-section-bg: {{ section.settings.section_background_color }};
      --clg-card-bg: {{ section.settings.rectangle_background_color }};
      --clg-card-text: {{ section.settings.rectangle_text_color }};
      --clg-border-color: {{ section.settings.border_color }};
      --clg-border-width: {{ section.settings.border_width }}px;
      --clg-radius: {{ section.settings.corner_radius }}px;
      --clg-mobile-top: {{ mobile_top_spacing }}px;
      --clg-mobile-bottom: {{ mobile_bottom_spacing }}px;
      --clg-desktop-top: {{ desktop_top_spacing }}px;
      --clg-desktop-bottom: {{ desktop_bottom_spacing }}px;
      --clg-mobile-columns: {{ mobile_columns }};
      --clg-tablet-columns: {{ tablet_columns }};
      --clg-desktop-columns: {{ desktop_columns }};
      --clg-mobile-gap: 1.2rem;
      --clg-tablet-gap: 1.4rem;
      --clg-desktop-gap: 1.6rem;
      --clg-card-min-height: 7.2rem;
      --clg-image-ratio: {{ image_ratio_value }};
      --clg-content-max: {{ content_max_width }}px;
      background: var(--clg-section-bg);
      padding-top: var(--clg-mobile-top);
      padding-bottom: var(--clg-mobile-bottom);
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .navigation-grid__content {
      max-width: min(100%, var(--clg-content-max));
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .navigation-grid__heading {
      margin: 0 0 0.8rem;
      text-align: {{ section.settings.heading_alignment }};
    }

    #shopify-section-{{ section.id }} .navigation-grid__description {
      margin: 0 0 1.8rem;
      color: rgba(var(--color-foreground), 0.75);
      text-align: {{ section.settings.heading_alignment }};
    }

    #shopify-section-{{ section.id }} .navigation-grid__description > * {
      margin: 0;
    }

    #shopify-section-{{ section.id }} .navigation-grid__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: stretch;
      justify-content: center;
      gap: var(--clg-mobile-gap);
    }

    #shopify-section-{{ section.id }} .navigation-grid__block {
      flex: 0 1 calc((100% - (var(--clg-mobile-columns) - 1) * var(--clg-mobile-gap)) / var(--clg-mobile-columns));
      max-width: calc((100% - (var(--clg-mobile-columns) - 1) * var(--clg-mobile-gap)) / var(--clg-mobile-columns));
      min-width: 0;
      display: flex;
      align-items: stretch;
      align-self: stretch;
    }

    #shopify-section-{{ section.id }} .navigation-grid__card {
      width: 100%;
      flex: 1 1 auto;
      align-self: stretch;
      min-height: var(--clg-card-min-height);
      border: var(--clg-border-width) solid var(--clg-border-color);
      border-radius: var(--clg-radius);
      background: var(--clg-card-bg);
      color: var(--clg-card-text);
      text-decoration: none;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: border-color 0.2s ease, background-color 0.2s ease;
    }

    #shopify-section-{{ section.id }} .navigation-grid__card--text-only {
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .navigation-grid__card-content {
      padding: 1.1rem 1.3rem 1.2rem;
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: 0.5rem;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .navigation-grid__card--text-only .navigation-grid__card-content {
      padding: 0.95rem 1.3rem;
    }

    #shopify-section-{{ section.id }} .navigation-grid--text-center .navigation-grid__card-content {
      align-items: center;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .navigation-grid--text-left .navigation-grid__card-content {
      align-items: flex-start;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .navigation-grid__title {
      margin: 0;
      color: currentColor;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      line-height: 1.3;
      font-size: 1.2rem;
      font-weight: 500;
      word-break: break-word;
      hyphens: auto;
    }

    #shopify-section-{{ section.id }} .navigation-grid__subtitle {
      margin: 0;
      color: rgba(var(--color-foreground), 0.78);
      text-transform: none;
      letter-spacing: 0;
      line-height: 1.45;
      font-size: 1.25rem;
      font-weight: 400;
    }

    #shopify-section-{{ section.id }} .navigation-grid__media {
      position: relative;
      width: 100%;
      aspect-ratio: var(--clg-image-ratio);
      overflow: hidden;
      background: rgba(var(--color-foreground), 0.05);
    }

    #shopify-section-{{ section.id }} .navigation-grid__media--adapt {
      aspect-ratio: auto;
    }

    #shopify-section-{{ section.id }} .navigation-grid__media-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.28s ease;
    }

    #shopify-section-{{ section.id }} .navigation-grid__media--adapt .navigation-grid__media-image {
      height: auto;
    }

    #shopify-section-{{ section.id }} .navigation-grid__card:hover {
      background: linear-gradient(0deg, rgba(var(--color-foreground), 0.03), rgba(var(--color-foreground), 0.03)), var(--clg-card-bg);
      border-color: rgba(var(--color-foreground), 0.35);
    }

    #shopify-section-{{ section.id }} .navigation-grid__card:hover .navigation-grid__media-image {
      transform: scale(1.03);
    }

    #shopify-section-{{ section.id }} .navigation-grid__card:focus-visible {
      outline: 0.2rem solid rgba(var(--color-foreground), 0.7);
      outline-offset: 0.2rem;
      border-color: rgba(var(--color-foreground), 0.5);
    }

    #shopify-section-{{ section.id }} .navigation-grid__card--placeholder {
      justify-content: center;
      opacity: 0.72;
    }

    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .navigation-grid__card,
      #shopify-section-{{ section.id }} .navigation-grid__media-image {
        transition: none;
      }
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .navigation-grid {
        padding-top: var(--clg-desktop-top);
        padding-bottom: var(--clg-desktop-bottom);
      }

      #shopify-section-{{ section.id }} .navigation-grid__heading {
        margin-bottom: 1rem;
      }

      #shopify-section-{{ section.id }} .navigation-grid__description {
        margin-bottom: 2rem;
      }

      #shopify-section-{{ section.id }} .navigation-grid__list {
        gap: var(--clg-tablet-gap);
      }

      #shopify-section-{{ section.id }} .navigation-grid__block {
        flex-basis: calc((100% - (var(--clg-tablet-columns) - 1) * var(--clg-tablet-gap)) / var(--clg-tablet-columns));
        max-width: calc((100% - (var(--clg-tablet-columns) - 1) * var(--clg-tablet-gap)) / var(--clg-tablet-columns));
      }
    }

    @media screen and (min-width: 990px) {
      #shopify-section-{{ section.id }} .navigation-grid__list {
        gap: var(--clg-desktop-gap);
      }

      #shopify-section-{{ section.id }} .navigation-grid__block {
        flex-basis: calc((100% - (var(--clg-desktop-columns) - 1) * var(--clg-desktop-gap)) / var(--clg-desktop-columns));
        max-width: calc((100% - (var(--clg-desktop-columns) - 1) * var(--clg-desktop-gap)) / var(--clg-desktop-columns));
      }
    }
  {%- endstyle -%}

  <div
    class="navigation-grid color-{{ section.settings.color_scheme }} gradient {% if section.settings.card_text_alignment == 'left' %}navigation-grid--text-left{% else %}navigation-grid--text-center{% endif %}"
  >
    <div class="page-width">
      <div class="navigation-grid__content">
        {%- if section.settings.show_heading and section.settings.heading != blank -%}
          <h2 class="navigation-grid__heading title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="navigation-grid__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        <ul class="navigation-grid__list" role="list">
          {%- assign rendered_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign selected_collection = block.settings.collection
              assign card_url = blank
              if block.settings.link != blank
                assign card_url = block.settings.link
              elsif selected_collection != blank
                assign card_url = selected_collection.url
              endif

              assign card_title = block.settings.title | strip
              if card_title == blank
                assign card_title = block.settings.custom_label | strip
              endif
              if card_title == blank and selected_collection != blank
                assign card_title = selected_collection.title
              endif

              assign card_subtitle = block.settings.subtitle | strip
              assign card_aria_label = block.settings.aria_label | strip

              assign card_image = block.settings.card_image
              if card_image == blank and section.settings.use_collection_image_fallback and block.settings.use_collection_image and selected_collection != blank
                assign card_image = selected_collection.featured_image
              endif

              assign show_card_image = false
              if section.settings.card_style != 'text_only' and card_image != blank
                assign show_card_image = true
              endif

              assign render_block = false
              if card_url != blank
                assign render_block = true
              elsif request.design_mode
                assign render_block = true
              endif
            -%}

            {%- if render_block -%}
              {%- assign rendered_count = rendered_count | plus: 1 -%}
              <li class="navigation-grid__block" {{ block.shopify_attributes }}>
                {%- if card_url != blank -%}
                  <a
                    class="navigation-grid__card{% unless show_card_image %} navigation-grid__card--text-only{% endunless %}"
                    href="{{ card_url }}"
                    {% if card_aria_label != blank %}
                      aria-label="{{ card_aria_label | escape }}"
                    {% endif %}
                  >
                    {%- if show_card_image -%}
                      <span class="navigation-grid__media{% if section.settings.image_ratio == 'adapt' %} navigation-grid__media--adapt{% endif %}">
                        {{
                          card_image
                          | image_url: width: 720
                          | image_tag:
                            widths: '240, 360, 480, 720',
                            sizes: '(min-width: 990px) 20vw, (min-width: 750px) 33vw, 50vw',
                            loading: 'lazy',
                            alt: '',
                            class: 'navigation-grid__media-image'
                        }}
                      </span>
                    {%- endif -%}

                    <span class="navigation-grid__card-content">
                      <span class="navigation-grid__title">{{ card_title | escape }}</span>
                      {%- if card_subtitle != blank -%}
                        <span class="navigation-grid__subtitle">{{ card_subtitle | escape }}</span>
                      {%- endif -%}
                    </span>
                  </a>
                {%- else -%}
                  <div class="navigation-grid__card navigation-grid__card--placeholder" role="note">
                    <span class="navigation-grid__card-content">
                      <span class="navigation-grid__title">{{ card_title | default: 'Navigation Card' | escape }}</span>
                    </span>
                  </div>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}

          {%- if rendered_count == 0 and request.design_mode -%}
            <li class="navigation-grid__block">
              <div class="navigation-grid__card navigation-grid__card--placeholder" role="note">
                <span class="navigation-grid__card-content">
                  <span class="navigation-grid__title">Add navigation cards to show links</span>
                </span>
              </div>
            </li>
          {%- endif -%}
        </ul>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Navigation Grid",
  "tag": "section",
  "class": "section section-navigation-grid",
  "max_blocks": 30,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": false
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h1",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_content_width",
      "label": "Maximum content width",
      "min": 700,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop cards per row",
      "default": "6",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ]
    },
    {
      "type": "select",
      "id": "tablet_columns",
      "label": "Tablet cards per row",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile cards per row",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "auto",
      "options": [
        {
          "value": "text_only",
          "label": "Text only"
        },
        {
          "value": "image",
          "label": "Image above text"
        },
        {
          "value": "auto",
          "label": "Automatic"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "landscape",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "adapt",
          "label": "Adapt to image"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "use_collection_image_fallback",
      "label": "Use collection image fallback",
      "default": true
    },
    {
      "type": "select",
      "id": "card_text_alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "rectangle_background_color",
      "label": "Card background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "rectangle_text_color",
      "label": "Card text color",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#BCBAB7"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 5
    },
    {
      "type": "range",
      "id": "desktop_spacing_top",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_spacing_bottom",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_spacing_top",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_spacing_bottom",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Navigation Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Image"
        },
        {
          "type": "checkbox",
          "id": "use_collection_image",
          "label": "Use collection image when no custom image is selected",
          "default": true
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "aria_label",
          "label": "Accessibility label"
        },
        {
          "type": "header",
          "content": "Collection fallback"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection fallback"
        },
        {
          "type": "text",
          "id": "custom_label",
          "label": "Legacy custom label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Navigation Grid"
    }
  ]
}
{% endschema %}