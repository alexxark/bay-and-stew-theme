{%- liquid
  assign configured_collection_count = 0
  assign renderable_item_count = 0

  for block in section.blocks
    if block.settings.collection != blank
      assign configured_collection_count = configured_collection_count | plus: 1
      assign renderable_item_count = renderable_item_count | plus: 1
    elsif request.design_mode
      assign renderable_item_count = renderable_item_count | plus: 1
    endif
  endfor

  assign should_render_section = configured_collection_count > 0 or request.design_mode

  assign mobile_page_count = 0
  if renderable_item_count > 0
    assign mobile_page_count = renderable_item_count | divided_by: 4
    assign mobile_page_remainder = renderable_item_count | modulo: 4
    if mobile_page_remainder > 0
      assign mobile_page_count = mobile_page_count | plus: 1
    endif
  elsif request.design_mode
    assign mobile_page_count = 1
  endif

  assign initial_mobile_total = mobile_page_count
  if initial_mobile_total == 0
    assign initial_mobile_total = 1
  endif

  assign desktop_spacing_legacy = section.settings.desktop_vertical_spacing | default: 28
  assign mobile_spacing_legacy = section.settings.mobile_vertical_spacing | default: 32

  assign desktop_top_spacing = section.settings.desktop_spacing_top
  if desktop_top_spacing == blank
    assign desktop_top_spacing = desktop_spacing_legacy | times: 0.85 | round
  endif

  assign desktop_bottom_spacing = section.settings.desktop_spacing_bottom
  if desktop_bottom_spacing == blank
    assign desktop_bottom_spacing = desktop_spacing_legacy | times: 0.4 | round
  endif

  assign mobile_top_spacing = section.settings.mobile_spacing_top
  if mobile_top_spacing == blank
    assign mobile_top_spacing = mobile_spacing_legacy | times: 0.75 | round
  endif

  assign mobile_bottom_spacing = section.settings.mobile_spacing_bottom
  if mobile_bottom_spacing == blank
    assign mobile_bottom_spacing = mobile_spacing_legacy | times: 0.3 | round
  endif
-%}

{%- if should_render_section -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .collection-link-grid {
      --clg-section-bg: {{ section.settings.section_background_color }};
      --clg-item-bg: {{ section.settings.rectangle_background_color }};
      --clg-item-text: {{ section.settings.rectangle_text_color }};
      --clg-border-color: {{ section.settings.border_color }};
      --clg-border-width: {{ section.settings.border_width }}px;
      --clg-radius: {{ section.settings.corner_radius }}px;
      --clg-mobile-top: {{ mobile_top_spacing }}px;
      --clg-mobile-bottom: {{ mobile_bottom_spacing }}px;
      --clg-desktop-top: {{ desktop_top_spacing }}px;
      --clg-desktop-bottom: {{ desktop_bottom_spacing }}px;
      --clg-desktop-gap: 1.2rem;
      --clg-mobile-gap: 1.2rem;
      --clg-columns: 6;
      background: var(--clg-section-bg);
      padding-top: var(--clg-mobile-top);
      padding-bottom: var(--clg-mobile-bottom);
      overflow-x: hidden;
      overflow-x: clip;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__heading {
      margin: 0 0 1.6rem;
      text-align: {{ section.settings.heading_alignment }};
    }

    #shopify-section-{{ section.id }} .collection-link-grid__item {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 6.4rem;
      padding: 0.8rem 1.2rem;
      border: var(--clg-border-width) solid var(--clg-border-color);
      border-radius: var(--clg-radius);
      background: var(--clg-item-bg);
      color: var(--clg-item-text);
      text-align: center;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      line-height: 1.25;
      font-size: 1.2rem;
      font-weight: 500;
      word-break: break-word;
      hyphens: auto;
      transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__item:hover,
    #shopify-section-{{ section.id }} .collection-link-grid__item:focus-visible {
      background: linear-gradient(0deg, rgba(var(--color-foreground), 0.04), rgba(var(--color-foreground), 0.04)), var(--clg-item-bg);
      border-color: rgba(var(--color-foreground), 0.35);
      background: color-mix(in srgb, var(--clg-item-bg) 86%, var(--clg-item-text) 14%);
      border-color: color-mix(in srgb, var(--clg-border-color) 80%, var(--clg-item-text) 20%);
      color: var(--clg-item-text);
    }

    #shopify-section-{{ section.id }} .collection-link-grid__item--placeholder {
      opacity: 0.72;
      cursor: default;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__desktop-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--clg-desktop-gap);
    }

    #shopify-section-{{ section.id }} .collection-link-grid__desktop-block {
      flex: 0 1 calc((100% - (var(--clg-columns) - 1) * var(--clg-desktop-gap)) / var(--clg-columns));
      min-width: 0;
      max-width: calc((100% - (var(--clg-columns) - 1) * var(--clg-desktop-gap)) / var(--clg-columns));
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile-viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile-viewport::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile-track {
      display: flex;
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile-page {
      flex: 0 0 100%;
      min-width: 100%;
      scroll-snap-align: start;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--clg-mobile-gap);
      padding: 0 0.1rem;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile-page--count-1 .collection-link-grid__mobile-block:first-child,
    #shopify-section-{{ section.id }} .collection-link-grid__mobile-page--count-3 .collection-link-grid__mobile-block:last-child {
      grid-column: 1 / -1;
      justify-self: center;
      width: max(14rem, calc(50% - (var(--clg-mobile-gap) / 2)));
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile-block {
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile .collection-link-grid__item {
      min-height: clamp(6.4rem, 15vw, 7.6rem);
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile-controls {
      margin-top: 1.2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.2rem;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile-arrow {
      width: 3.4rem;
      height: 3.4rem;
      border-radius: 50%;
      border: 0.1rem solid rgba(var(--color-foreground), 0.2);
      background: rgb(var(--color-background));
      color: rgb(var(--color-foreground));
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: opacity 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile-arrow .svg-wrapper {
      width: 1.6rem;
      height: 1.6rem;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile-arrow .icon-caret {
      position: static;
      right: auto;
      top: auto;
      width: auto;
      height: 0.8rem;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile-arrow--prev .icon-caret {
      transform: rotate(90deg);
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile-arrow--next .icon-caret {
      transform: rotate(-90deg);
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile-arrow:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    #shopify-section-{{ section.id }} .collection-link-grid__mobile-counter {
      margin: 0;
      min-width: 5.6rem;
      text-align: center;
      letter-spacing: 0.04em;
    }

    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .collection-link-grid__item,
      #shopify-section-{{ section.id }} .collection-link-grid__mobile-arrow {
        transition: none;
      }

      #shopify-section-{{ section.id }} .collection-link-grid__mobile-viewport {
        scroll-behavior: auto;
      }
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .collection-link-grid {
        padding-top: var(--clg-desktop-top);
        padding-bottom: var(--clg-desktop-bottom);
      }

      #shopify-section-{{ section.id }} .collection-link-grid__heading {
        margin-bottom: 1.8rem;
      }

      #shopify-section-{{ section.id }} .collection-link-grid__desktop {
        display: block;
      }

      #shopify-section-{{ section.id }} .collection-link-grid__mobile {
        display: none;
      }
    }
  {%- endstyle -%}

  <div class="collection-link-grid color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width">
      {%- if section.settings.show_heading and section.settings.heading != blank -%}
        <h2 class="collection-link-grid__heading title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      <div class="collection-link-grid__desktop">
        <ul class="collection-link-grid__desktop-list" role="list">
          {%- assign desktop_rendered_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign selected_collection = block.settings.collection
              assign item_label = block.settings.custom_label | strip
              if item_label == blank and selected_collection != blank
                assign item_label = selected_collection.title
              endif
            -%}

            {%- if selected_collection != blank -%}
              {%- assign desktop_rendered_count = desktop_rendered_count | plus: 1 -%}
              <li class="collection-link-grid__desktop-block" {{ block.shopify_attributes }}>
                <a class="collection-link-grid__item" href="{{ selected_collection.url }}">
                  {{ item_label | escape }}
                </a>
              </li>
            {%- elsif request.design_mode -%}
              {%- assign desktop_rendered_count = desktop_rendered_count | plus: 1 -%}
              <li class="collection-link-grid__desktop-block" {{ block.shopify_attributes }}>
                <div class="collection-link-grid__item collection-link-grid__item--placeholder" role="note">
                  {{ item_label | default: 'Collection' | escape }}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}

          {%- if desktop_rendered_count == 0 and request.design_mode -%}
            <li class="collection-link-grid__desktop-block">
              <div class="collection-link-grid__item collection-link-grid__item--placeholder" role="note">
                Add collection blocks to show links
              </div>
            </li>
          {%- endif -%}
        </ul>
      </div>

      <div class="collection-link-grid__mobile" data-collection-link-grid>
        <div
          id="CollectionLinkGridMobile-{{ section.id }}"
          class="collection-link-grid__mobile-viewport"
          data-collection-link-grid-scroller
        >
          <div class="collection-link-grid__mobile-track">
            {%- if renderable_item_count > 0 -%}
              {%- assign mobile_item_index = 0 -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign selected_collection = block.settings.collection
                  assign item_label = block.settings.custom_label | strip
                  if item_label == blank and selected_collection != blank
                    assign item_label = selected_collection.title
                  endif

                  assign render_mobile_item = false
                  if selected_collection != blank or request.design_mode
                    assign render_mobile_item = true
                  endif
                -%}

                {%- if render_mobile_item -%}
                  {%- assign mobile_item_index = mobile_item_index | plus: 1 -%}
                  {%- assign page_position = mobile_item_index | modulo: 4 -%}

                  {%- if page_position == 1 -%}
                    {%- assign remaining_items = renderable_item_count | minus: mobile_item_index | plus: 1 -%}
                    {%- assign page_item_count = 4 -%}
                    {%- if remaining_items < 4 -%}
                      {%- assign page_item_count = remaining_items -%}
                    {%- endif -%}
                    {%- assign page_number = mobile_item_index | minus: 1 | divided_by: 4 | plus: 1 -%}
                    <div
                      class="collection-link-grid__mobile-page collection-link-grid__mobile-page--count-{{ page_item_count }}"
                      role="group"
                      aria-label="Collections page {{ page_number }} of {{ mobile_page_count }}"
                    >
                  {%- endif -%}

                  <div class="collection-link-grid__mobile-block">
                    {%- if selected_collection != blank -%}
                      <a class="collection-link-grid__item" href="{{ selected_collection.url }}">
                        {{ item_label | escape }}
                      </a>
                    {%- else -%}
                      <div class="collection-link-grid__item collection-link-grid__item--placeholder" role="note">
                        {{ item_label | default: 'Collection' | escape }}
                      </div>
                    {%- endif -%}
                  </div>

                  {%- if page_position == 0 or mobile_item_index == renderable_item_count -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- elsif request.design_mode -%}
              <div class="collection-link-grid__mobile-page collection-link-grid__mobile-page--count-1" role="group" aria-label="Collections page 1 of 1">
                <div class="collection-link-grid__mobile-block">
                  <div class="collection-link-grid__item collection-link-grid__item--placeholder" role="note">
                    Add collection blocks to show links
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>

        <div class="collection-link-grid__mobile-controls" data-collection-link-grid-controls>
          <button
            class="collection-link-grid__mobile-arrow collection-link-grid__mobile-arrow--prev"
            type="button"
            aria-label="Previous collections"
            aria-controls="CollectionLinkGridMobile-{{ section.id }}"
            data-collection-link-grid-prev
            disabled
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>

          <p class="collection-link-grid__mobile-counter caption" aria-live="polite">
            <span data-collection-link-grid-current>1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span data-collection-link-grid-total>{{ initial_mobile_total }}</span>
          </p>

          <button
            class="collection-link-grid__mobile-arrow collection-link-grid__mobile-arrow--next"
            type="button"
            aria-label="Next collections"
            aria-controls="CollectionLinkGridMobile-{{ section.id }}"
            data-collection-link-grid-next
            {% if initial_mobile_total <= 1 %}
              disabled
            {% endif %}
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function() {
      var namespace = 'CollectionLinkGridSection';

      function getRoots(context) {
        var roots = [];
        if (!context) return roots;

        if (context.matches && context.matches('[data-collection-link-grid]')) {
          roots.push(context);
        }

        if (context.querySelectorAll) {
          context.querySelectorAll('[data-collection-link-grid]').forEach(function(root) {
            roots.push(root);
          });
        }

        return roots;
      }

      if (!window[namespace]) {
        var instances = new WeakMap();

        function getPageCount(scroller) {
          var pages = scroller.querySelectorAll('.collection-link-grid__mobile-page');
          return pages.length || 1;
        }

        function getCurrentPage(scroller) {
          var pageWidth = scroller.clientWidth || 1;
          var page = Math.round(scroller.scrollLeft / pageWidth) + 1;
          var pageCount = getPageCount(scroller);
          return Math.max(1, Math.min(page, pageCount));
        }

        function updateState(instance) {
          var scroller = instance.scroller;
          var previousButton = instance.previousButton;
          var nextButton = instance.nextButton;
          var currentLabel = instance.currentLabel;
          var totalLabel = instance.totalLabel;

          var pageCount = getPageCount(scroller);
          var currentPage = getCurrentPage(scroller);

          currentLabel.textContent = String(currentPage);
          totalLabel.textContent = String(pageCount);

          var atStart = currentPage <= 1;
          var atEnd = currentPage >= pageCount;

          previousButton.disabled = atStart;
          nextButton.disabled = atEnd;
          previousButton.setAttribute('aria-disabled', atStart ? 'true' : 'false');
          nextButton.setAttribute('aria-disabled', atEnd ? 'true' : 'false');
        }

        function createInstance(root) {
          if (instances.has(root)) return;

          var scroller = root.querySelector('[data-collection-link-grid-scroller]');
          var previousButton = root.querySelector('[data-collection-link-grid-prev]');
          var nextButton = root.querySelector('[data-collection-link-grid-next]');
          var currentLabel = root.querySelector('[data-collection-link-grid-current]');
          var totalLabel = root.querySelector('[data-collection-link-grid-total]');

          if (!scroller || !previousButton || !nextButton || !currentLabel || !totalLabel) return;

          var frameRequested = false;

          function queueStateUpdate() {
            if (frameRequested) return;
            frameRequested = true;
            requestAnimationFrame(function() {
              frameRequested = false;
              updateState(api);
            });
          }

          function scrollToPage(pageNumber) {
            var targetPage = Math.max(1, Math.min(pageNumber, getPageCount(scroller)));
            var pageWidth = scroller.clientWidth || 1;
            var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            scroller.scrollTo({
              left: (targetPage - 1) * pageWidth,
              behavior: reduceMotion ? 'auto' : 'smooth'
            });
          }

          function onPreviousClick() {
            scrollToPage(getCurrentPage(scroller) - 1);
          }

          function onNextClick() {
            scrollToPage(getCurrentPage(scroller) + 1);
          }

          function onScroll() {
            queueStateUpdate();
          }

          function onResize() {
            queueStateUpdate();
          }

          previousButton.addEventListener('click', onPreviousClick);
          nextButton.addEventListener('click', onNextClick);
          scroller.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onResize);

          var api = {
            scroller: scroller,
            previousButton: previousButton,
            nextButton: nextButton,
            currentLabel: currentLabel,
            totalLabel: totalLabel,
            destroy: function() {
              previousButton.removeEventListener('click', onPreviousClick);
              nextButton.removeEventListener('click', onNextClick);
              scroller.removeEventListener('scroll', onScroll);
              window.removeEventListener('resize', onResize);
            }
          };

          instances.set(root, api);
          queueStateUpdate();
        }

        function init(context) {
          getRoots(context).forEach(createInstance);
        }

        function cleanup(context) {
          getRoots(context).forEach(function(root) {
            var instance = instances.get(root);
            if (!instance) return;
            instance.destroy();
            instances.delete(root);
          });
        }

        window[namespace] = {
          init: init,
          cleanup: cleanup
        };

        document.addEventListener('shopify:section:load', function(event) {
          init(event.target);
        });

        document.addEventListener('shopify:section:unload', function(event) {
          cleanup(event.target);
        });

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function() {
            init(document);
          });
        } else {
          init(document);
        }
      } else {
        window[namespace].init(document);
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Collection link grid",
  "tag": "section",
  "class": "section section-collection-link-grid",
  "max_blocks": 30,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h1",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "rectangle_background_color",
      "label": "Rectangle background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "rectangle_text_color",
      "label": "Rectangle text color",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#D7D2C8"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "desktop_spacing_top",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_spacing_bottom",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_spacing_top",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_spacing_bottom",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_label",
          "label": "Custom label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection link grid"
    }
  ]
}
{% endschema %}
