    "collapsible_content_dxpwLt": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_PawBpC": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Artwork Fees",
            "icon": "check_mark",
            "row_content": "<p>Production-ready artwork — FREE. If finalized artwork meets our stamp production requirements and needs no changes, there is no design fee.</p><p>Simple artwork preparation — $35. For cleanup, minor modifications or formatting existing artwork for stamp production.</p><p>Complex custom design — $75. For original designs or recreating reference images, illustrations or concepts for stamping.</p><p>Paid design fees include up to two revision rounds. Additional revisions may incur extra fees.</p>",
            "page": ""
          }
        },
        "collapsible_row_paRKL8": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Set Up Fee",
            "icon": "check_mark",
            "row_content": "<p>Custom stamp setup — starting at $175.&nbsp;</p><p>Each unique design requires its own custom stamp. The final setup fee depends on size and complexity, and larger designs may require larger, more expensive stamps. Our team will review the artwork and chosen blank and confirm your fee before proceeding.</p><p>Repeat orders using the same unchanged design generally do not require a new setup fee if the original stamp remains available and usable.</p>",
            "page": ""
          }
        },
        "collapsible_row_KeKhgy": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Available Hand-Stamped Blanks",
            "icon": "check_mark",
            "row_content": "<p>Custom stamping is offered on <a href=\"https://bayandstew.com/collections/blanks\" target=\"_blank\" title=\"https://bayandstew.com/collections/blanks\">eligible items from our existing hand-stamped collection</a>.</p><p>We do not offer custom blank shapes or cutout designs through this service.</p>",
            "page": ""
          }
        },
        "collapsible_row_mXVw6j": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Production Timeline",
            "icon": "check_mark",
            "row_content": "<p>Custom stamp production takes approximately 4 weeks after final artwork approval and payment. Additional time may be needed to create your hand-stamped items depending on quantity, material availability and production scheduling.&nbsp;</p><p>Please include any event deadline with your request. Production and delivery dates are estimates, not guarantees.</p>",
            "page": ""
          }
        },
        "collapsible_row_93iQMa": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Design and Intellectual Property Requirements",
            "icon": "check_mark",
            "row_content": "<p>All designs are reviewed individually and require Bay & Stew approval. Fine details may need simplification; designs must fit the available stamp area.</p><p>We cannot reproduce trademarked designs, company or sports logos, characters, or other protected artwork without appropriate authorization and our approval. You must own the artwork or hold the necessary rights and permissions to reproduce it. We reserve the right to decline a design.</p><p>Slight variations in placement or impression depth are normal with hand-stamped products.</p>",
            "page": ""
          }
        },
        "collapsible_row_DNmTPb": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How to Order",
            "icon": "check_mark",
            "row_content": "<p>1. Submit the Custom Hand-Stamped Request Form, including your artwork or reference image, preferred blank, materials, quantity, and deadline.</p><p>2. Our team individually reviews the request and confirms feasibility and pricing.</p><p>3. If design work is needed, we prepare the artwork and send a PDF proof for your approval.</p><p>4. After final artwork approval and payment, custom stamp production begins.</p><p>5. Once the stamp is ready, we produce, inspect and ship your hand-stamped products.</p>",
            "page": ""
          }
        },
        "collapsible_row_jNkyyB": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Important",
            "icon": "check_mark",
            "row_content": "<p>Every request is subject to approval. Design and setup fees are nonrefundable once the corresponding work has begun. Artwork changes after approval may require additional fees. Custom orders are final sale except for verified defects or production errors.</p>",
            "page": ""
          }
        }
      },
