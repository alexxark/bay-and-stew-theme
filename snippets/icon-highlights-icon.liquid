{% comment %}
  Renders a built-in SVG icon for the Icon Highlights section.

  Accepts:
  - icon: {String} Icon key.
  - class: {String} Optional CSS class.
{% endcomment %}
{%- liquid
  assign icon_name = icon | default: 'shield_verified'
-%}
