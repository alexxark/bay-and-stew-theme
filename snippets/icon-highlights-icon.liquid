      <path d="M14.9 6C15.8 6 16.5 5.3 16.5 4.4C16.5 3.5 15.8 2.8 14.9 2.8C12.9 2.8 12 6 12 6H14.9Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    {%- else -%}
      <path d="M12 3.8L14.5 8.9L20.2 9.8L16.1 13.8L17.1 19.4L12 16.7L6.9 19.4L7.9 13.8L3.8 9.8L9.5 8.9L12 3.8Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  {%- endcase -%}
