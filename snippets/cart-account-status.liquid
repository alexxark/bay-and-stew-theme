{%- comment -%}
  Cart Account Status
  --------------------------------------------------------------------------
  Native Liquid replacement for the disabled BLOY rewards sign-in panel.
  Shown in the cart summary area, above the estimated total.

  Reuses the theme's existing product-price status bubble
  (snippets/customer-status-badge.liquid) and its wholesale condition
  unchanged: a signed-in customer is wholesale only if their tags contain
  "b2b" (case-insensitive); signed in without that tag is retail; no
  customer is signed out.

  Accepts:
    - context: {String} optional, 'drawer' (default) or 'page'. Adds a
      modifier class as a hook for context-specific styling.

  Usage:
    {% render 'cart-account-status' %}
    {% render 'cart-account-status', context: 'page' %}
{%- endcomment -%}
{%- liquid
  assign context = context | default: 'drawer'
  assign tag_str = customer.tags | join: ',' | downcase
  assign is_wholesale = false
  if customer and tag_str contains 'b2b'
    assign is_wholesale = true
  endif

  if customer == null
  capture status_note
    echo 'Retail pricing is active. Approved wholesale accounts can <a href="'
    echo routes.storefront_login_url
    echo '">sign in</a> for wholesale pricing.'
  endcapture
elsif is_wholesale
  assign status_note = 'You’re signed in, and wholesale pricing is active for this account.'
else
  assign status_note = 'You’re signed in, retail status is active for this account. Apply <a href="/pages/apply-for-wholesale">here</a> for wholesale access.'
endif
-%}
<div class="cart-account-status cart-account-status--{{ context }}">
  <div class="cart-account-status__info">
    {%- render 'customer-status-badge', class: 'cart-account-status__badge', show_tooltip: false -%}
    <p class="cart-account-status__note">{{ status_note }}</p>
  </div>
</div>
